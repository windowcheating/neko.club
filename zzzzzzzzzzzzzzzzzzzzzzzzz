function API:EnableGunESP() geEnable() end
function API:DisableGunESP() geDisable() end
function API:ToggleGunESP() if GE.enabled then geEnable() else geDisable() end end
function API:IsGunESPEnabled() return GE.enabled end

function API:EnableTrapESP() teEnable() end
function API:DisableTrapESP() teDisable() end
function API:ToggleTrapESP() if TE.enabled then teDisable() else teEnable() end end
function API:IsTrapESPEnabled() return TE.enabled end

function API:EnableFootsteps() fsEnable() end
function API:DisableFootsteps() fsDisable() end
function API:ToggleFootsteps() if FS.enabled then fsDisable() else fsEnable() end end
function API:IsFootstepsEnabled() return FS.enabled end

function API:EnableAll()
    hlEnable(); geEnable(); teEnable(); fsEnable()
end

function API:DisableAll()
    hlDisable(); geDisable(); teDisable(); fsDisable()
end

function API:Destroy()
    self:DisableAll()
    HL.folder:Destroy()
    GE.hlFolder:Destroy()
    GE.tagFolder:Destroy()
    TE.folder:Destroy()
end

-- Hook into Library theme listeners on first enable of gun ESP
local lib = getgenv().Library
if lib and lib._themeListeners then
    table.insert(lib._themeListeners, onThemeChanged)
end

return API
