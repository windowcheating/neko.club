local function geAddForGun(gunPart)
    if not gunPart or not gunPart.Parent then return end
    for _, hl in ipairs(GE.hlFolder:GetChildren()) do
        if hl.Adornee == gunPart then return end
    end
    local hl = Instance.new("Highlight")
    hl.Name = "GunHL"
    hl.Adornee = gunPart
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = Color3.fromRGB(30, 30, 30)
    hl.FillTransparency = 0.65
    hl.OutlineColor = getAccentColor()
    hl.OutlineTransparency = 0.2
    hl.Parent = GE.hlFolder
    local bb = geCreateLabel(hl)
    bb.Adornee = gunPart
    geAssignOwner(hl, bb, gunPart)
end

local function geScan()
    for _, d in ipairs(workspace:GetDescendants()) do
        if d.Name == "GunDrop" and (d:IsA("BasePart") or d:IsA("Model")) then
            geAddForGun(d)
        end
    end
end

local function geClearAll()
    GE.hlFolder:ClearAllChildren()
    for _, bb in pairs(GE.labelStore) do bb:Destroy() end
    table.clear(GE.labelStore)
    table.clear(GE.ownerData)
end

local function geAttachDeath(char, plr)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    if hum then hum.Died:Connect(function() geRecordDeath(plr) end) end
end

local function geSetupPlayer(p)
    if GE.charConns[p] then return end
    GE.charConns[p] = p.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        geAttachDeath(char, p)
    end)
    if p.Character then geAttachDeath(p.Character, p) end
end

local function geRenderStep()
    local lp = game.Players.LocalPlayer
    local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")

    for _, child in ipairs(GE.hlFolder:GetChildren()) do
        if child.Name == "GunHL" then
            local gunPart = child.Adornee
            if not gunPart or not gunPart.Parent then
                local bb = GE.labelStore[child]
                if bb then bb:Destroy() end
                GE.labelStore[child] = nil
                GE.ownerData[child] = nil
                child:Destroy()
            else
                local bb = GE.labelStore[child]
                if not bb then bb = geCreateLabel(child) end
                bb.Adornee = gunPart
                if not GE.ownerData[child] then geAssignOwner(child, bb, gunPart) end
                if hrp then
                    local dist
                    if gunPart:IsA("Model") then
                        local pp = gunPart:FindFirstChildWhichIsA("BasePart")
                        if pp then dist = math.floor((hrp.Position - pp.Position).Magnitude) end
                    else
                        dist = math.floor((hrp.Position - gunPart.Position).Magnitude)
                    end
                    if dist then
                        local dLbl = bb:FindFirstChild("DistLbl", true)
                        if dLbl then dLbl.Text = dist .. "m" end
                    end
                end
            end
        end
    end
end

local function geEnable()
    if GE.enabled then return end
    GE.enabled = true
    for _, p in ipairs(game.Players:GetPlayers()) do geSetupPlayer(p) end
    GE.playerAddedConn = game.Players.PlayerAdded:Connect(geSetupPlayer)
    GE.descendantConn = workspace.DescendantAdded:Connect(function(d)
        if d.Name == "GunDrop" and (d:IsA("BasePart") or d:IsA("Model")) then geAddForGun(d) end
    end)
    geScan()
    GE.renderConn = game:GetService("RunService").RenderStepped:Connect(geRenderStep)
end

local function geDisable()
    if not GE.enabled then return end
    GE.enabled = false
    if GE.renderConn then GE.renderConn:Disconnect(); GE.renderConn = nil end
    if GE.descendantConn then GE.descendantConn:Disconnect(); GE.descendantConn = nil end
    if GE.playerAddedConn then GE.playerAddedConn:Disconnect(); GE.playerAddedConn = nil end
    for _, conn in pairs(GE.charConns) do conn:Disconnect() end
    table.clear(GE.charConns)
    geClearAll()
    table.clear(GE.recentDeaths)
end

