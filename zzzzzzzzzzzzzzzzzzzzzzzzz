-- allesp.lua — Absolute Final Fix (Highlight ONLY the body, no props)
local API = {}

--==============================================================
-- Shared colors
--==============================================================
local C = {
    Innocent = Color3.fromHex("#B1FFB1"),
    Murderer = Color3.fromHex("#FF7272"),
    Sheriff  = Color3.fromHex("#ACD7FF"),
    Trap     = Color3.fromHex("#A855F7"),
}

local function getAccentColor()
    local lib = getgenv().Library
    local theme = lib and lib.Theme
    if theme and theme.Accent then
        if typeof(theme.Accent) == "ColorSequence" then
            return theme.Accent.Keypoints[1].Value
        elseif typeof(theme.Accent) == "Color3" then
            return theme.Accent
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

--==============================================================
-- EXODUS ROLE DETECTION
--==============================================================
local function getPlayerRole(p)
    if p.Character then
        if p.Character:FindFirstChild("Knife") or (p.Backpack and p.Backpack:FindFirstChild("Knife")) then
            return "Murderer"
        end
        if p.Character:FindFirstChild("Gun") or (p.Backpack and p.Backpack:FindFirstChild("Gun")) then
            return "Sheriff"
        end
    end
    return "Innocent"
end

--==============================================================
-- 1) HIGHLIGHT + NEON CHAMS (Dummy Rig Method)
--==============================================================
local HL = {
    enabled = false,
    renderConn = nil,
    playerAddedConn = nil,
    charConns = {},
    playerRoles = {},
    playerCharRefs = {},
    playerOriginalData = {},
    playerChamsParts = {},
    playerHiddenClothes = {},
    playerDummyRigs = {},
}

HL.folder = Instance.new("Folder")
HL.folder.Name = "ESP_Highlight_Chams"
HL.folder.Parent = game:GetService("CoreGui")

local function hlClearForPlayer(player)
    if HL.playerHiddenClothes[player] then
        for _, obj in pairs(HL.playerHiddenClothes[player]) do
            pcall(function() if obj and player.Character then obj.Parent = player.Character end end)
        end
        HL.playerHiddenClothes[player] = nil
    end
    if HL.playerOriginalData[player] then
        for part, data in pairs(HL.playerOriginalData[player]) do
            pcall(function()
                if part and part.Parent then
                    if data.Material then part.Material = data.Material end
                    if data.Color then part.Color = data.Color end
                    if data.Transparency then part.Transparency = data.Transparency end
                    if data.Texture and part:IsA("MeshPart") then part.TextureID = data.Texture end
                    if data.MeshId and part:IsA("SpecialMesh") then part.MeshId = data.MeshId end
                end
            end)
        end
        HL.playerOriginalData[player] = nil
    end
    if HL.playerChamsParts[player] then
        for _, part in pairs(HL.playerChamsParts[player]) do
            pcall(function() if part and part.Parent then part:Destroy() end end)
        end
        HL.playerChamsParts[player] = nil
    end
    if HL.playerDummyRigs[player] then
        pcall(function() HL.playerDummyRigs[player]:Destroy() end)
        HL.playerDummyRigs[player] = nil
    end
    
    local hl = HL.folder:FindFirstChild("ChamsHL_" .. player.Name)
    if hl then hl:Destroy() end
    local innocentHL = HL.folder:FindFirstChild(player.Name)
    if innocentHL then innocentHL:Destroy() end
end

local function hlApply(player, color)
    local char = player.Character
    if not char then return end
    hlClearForPlayer(player)
    HL.playerOriginalData[player] = {}
    HL.playerChamsParts[player] = {}
    HL.playerHiddenClothes[player] = {}

    -- DUMMY RIG FOR HIGHLIGHT (Prevents props from glowing)
    local dummy = Instance.new("Model")
    dummy.Name = "DummyRig"
    
    local hl = Instance.new("Highlight")
    hl.Name = "ChamsHL_" .. player.Name
    hl.Adornee = dummy
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.FillColor = Color3.fromRGB(20, 20, 20)
    hl.FillTransparency = 0.2
    hl.OutlineColor = color
    hl.OutlineTransparency = 0.2
    hl.Parent = HL.folder
    HL.playerDummyRigs[player] = dummy

    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            table.insert(HL.playerHiddenClothes[player], obj)
            obj.Parent = nil
        end
    end

    local whitelist = {
        "Head","Torso","UpperTorso","LowerTorso",
        "LeftArm","RightArm","LeftLeg","RightLeg",
        "LeftUpperArm","LeftLowerArm","LeftHand",
        "RightUpperArm","RightLowerArm","RightHand",
        "LeftUpperLeg","LeftLowerLeg","LeftFoot",
        "RightUpperLeg","RightLowerLeg","RightFoot",
    }
    local partSet = {}
    for _, n in ipairs(whitelist) do partSet[n] = true end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") and partSet[obj.Name] then
            -- Add to dummy rig
            local proxy = Instance.new("Part")
            proxy.Size = obj.Size
            proxy.Transparency = 1
            proxy.CanCollide = false
            proxy.Anchored = true
            proxy.CFrame = obj.CFrame
            proxy.Parent = dummy
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = obj
            weld.Part1 = proxy
            weld.Parent = proxy

            -- Create Neon Cham
            HL.playerOriginalData[player][obj] = {
                Material = obj.Material, Color = obj.Color, Transparency = obj.Transparency,
                Texture = obj:IsA("MeshPart") and obj.TextureID or nil
            }
            obj.Transparency = 1
            if obj:IsA("MeshPart") then obj.TextureID = "" end
            local mesh = obj:FindFirstChildOfClass("SpecialMesh")
            if mesh then
                if not HL.playerOriginalData[player][mesh] then HL.playerOriginalData[player][mesh] = { MeshId = mesh.MeshId } end
                mesh.MeshId = ""
            end
            local clone = obj:Clone()
            clone.Name = "NeonCham_" .. obj.Name
            clone.CanCollide = false
            clone.CanTouch = false
            clone.CanQuery = false
            clone.Massless = true
            clone.Material = Enum.Material.Neon
            clone.Color = color
            clone.Transparency = 0
            clone.Parent = char
            if clone:IsA("MeshPart") then clone.TextureID = "" end
            if clone:FindFirstChildOfClass("SpecialMesh") then clone:FindFirstChildOfClass("SpecialMesh"):Destroy() end
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("Decal") or d:IsA("Texture") or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("TouchTransmitter") then
                    d:Destroy()
                end
            end
            local weld2 = Instance.new("WeldConstraint")
            weld2.Part0 = obj
            weld2.Part1 = clone
            weld2.Parent = clone
            table.insert(HL.playerChamsParts[player], clone)
        elseif obj:IsA("Accessory") then
            local handle = obj:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") and handle:IsDescendantOf(char) then
                HL.playerOriginalData[player][handle] = {
                    Material = handle.Material, Color = handle.Color, Transparency = handle.Transparency,
                    Texture = handle:IsA("MeshPart") and handle.TextureID or nil
                }
                handle.Transparency = 1
                if handle:IsA("MeshPart") then handle.TextureID = "" end
                local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                if mesh then
                    if not HL.playerOriginalData[player][mesh] then HL.playerOriginalData[player][mesh] = { MeshId = mesh.MeshId } end
                    mesh.MeshId = ""
                end
                local clone = handle:Clone()
                clone.Name = "NeonCham_Acc_" .. handle.Name
                clone.CanCollide = false
                clone.CanTouch = false
                clone.CanQuery = false
                clone.Massless = true
                clone.Material = Enum.Material.Neon
                clone.Color = color
                clone.Transparency = 0
                clone.Parent = char
                if clone:IsA("MeshPart") then clone.TextureID = "" end
                if clone:FindFirstChildOfClass("SpecialMesh") then clone:FindFirstChildOfClass("SpecialMesh"):Destroy() end
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("Decal") or d:IsA("Texture") or d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("TouchTransmitter") then
                        d:Destroy()
                    end
                end
                local weld3 = Instance.new("WeldConstraint")
                weld3.Part0 = handle
                weld3.Part1 = clone
                weld3.Parent = clone
                table.insert(HL.playerChamsParts[player], clone)
            end
        end
    end
    dummy.Parent = HL.folder
end

local function hlSetupPlayer(p)
    if HL.charConns[p] then return end
    HL.charConns[p] = p.CharacterAdded:Connect(function()
        task.wait(0.5)
        HL.playerRoles[p] = nil
        HL.playerCharRefs[p] = nil
    end)
end

local function hlRenderStep()
    local lp = game.Players.LocalPlayer

    for _, p in ipairs(game.Players:GetPlayers()) do
        if p ~= lp then
            local char = p.Character
            if char then
                if HL.playerCharRefs[p] ~= char then
                    HL.playerCharRefs[p] = char
                    HL.playerRoles[p] = nil
                end

                local role = getPlayerRole(p)

                if HL.playerRoles[p] ~= role then
                    HL.playerRoles[p] = role
                    if role == "Murderer" then
                        hlApply(p, C.Murderer)
                    elseif role == "Sheriff" then
                        hlApply(p, C.Sheriff)
                    else
                        hlClearForPlayer(p)
                    end
                end

                if role == "Innocent" then
                    local hl = HL.folder:FindFirstChild(p.Name)
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = p.Name
                        hl.Adornee = char
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = HL.folder
                    else
                        hl.Adornee = char
                    end
                    hl.FillColor = Color3.fromRGB(30, 30, 30)
                    hl.OutlineColor = C.Innocent
                    hl.FillTransparency = 0.65
                    hl.OutlineTransparency = 0.2
                else
                    local hl = HL.folder:FindFirstChild(p.Name)
                    if hl then hl:Destroy() end
                end
            else
                HL.playerRoles[p] = nil
                HL.playerCharRefs[p] = nil
            end
        end
    end
end

local function hlEnable()
    if HL.enabled then return end
    HL.enabled = true
    for _, p in ipairs(game.Players:GetPlayers()) do hlSetupPlayer(p) end
    HL.playerAddedConn = game.Players.PlayerAdded:Connect(hlSetupPlayer)
    HL.renderConn = game:GetService("RunService").RenderStepped:Connect(hlRenderStep)
end

local function hlDisable()
    if not HL.enabled then return end
    HL.enabled = false
    if HL.renderConn then HL.renderConn:Disconnect(); HL.renderConn = nil end
    if HL.playerAddedConn then HL.playerAddedConn:Disconnect(); HL.playerAddedConn = nil end
    for _, conn in pairs(HL.charConns) do conn:Disconnect() end
    table.clear(HL.charConns)
    HL.folder:ClearAllChildren()
    for _, p in ipairs(game.Players:GetPlayers()) do
        hlClearForPlayer(p)
        HL.playerRoles[p] = nil
        HL.playerCharRefs[p] = nil
    end
end

