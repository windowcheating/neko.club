--==============================================================
local TE = { enabled = false, descendantConn = nil }
TE.folder = Instance.new("Folder")
TE.folder.Name = "ESP_Trap_Adornments"
TE.folder.Parent = game:GetService("CoreGui")

local function teIsTrap(obj)
    if obj.Name ~= "Trap" then return false end
    local parent = obj.Parent
    if not parent then return false end
    if not (parent:IsA("Folder") or parent:IsA("Model")) then return false end
    return obj:IsA("BasePart") or obj:IsA("Model")
end

local function teAdd(trap)
    if not trap or not trap.Parent then return end
    for _, ad in ipairs(TE.folder:GetChildren()) do
        if ad.Adornee == trap then return end
    end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = "TrapBox"
    box.Adornee = trap
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = trap:IsA("Model") and (trap:GetExtentsSize() + Vector3.new(0.2, 0.2, 0.2)) or (trap.Size + Vector3.new(0.2, 0.2, 0.2))
    box.Color3 = C.Trap
    box.Transparency = 0.5
    box.Parent = TE.folder
    
    if trap:IsA("BasePart") then trap.Transparency = 0 end
end

local function teScan()
    for _, d in ipairs(workspace:GetDescendants()) do
        if teIsTrap(d) then teAdd(d) end
    end
end

local function teEnable()
    if TE.enabled then return end
    TE.enabled = true
    TE.descendantConn = workspace.DescendantAdded:Connect(function(d)
        if teIsTrap(d) then teAdd(d) end
    end)
    teScan()
end

local function teDisable()
    if not TE.enabled then return end
    TE.enabled = false
    if TE.descendantConn then TE.descendantConn:Disconnect(); TE.descendantConn = nil end
    TE.folder:ClearAllChildren()
end

--==============================================================
-- 4) FOOTSTEP TRAILS
--==============================================================
local FS = {
    enabled = false,
    heartbeatConn = nil,
    prints = {},
    last = setmetatable({}, { __mode = "k" }),
    side = setmetatable({}, { __mode = "k" }),
    folder = nil,
    LIFE = 8,
    AT = 0,
    RAY = RaycastParams.new(),
}
FS.RAY.FilterType = Enum.RaycastFilterType.Exclude

local function fsTint(role)
    if role == "Murderer" then return C.Murderer end
    if role == "Sheriff" then return C.Sheriff end
    return C.Innocent
end

local function fsClear()
    for i = #FS.prints, 1, -1 do
        local e = FS.prints[i]
        pcall(function() e.part:Destroy() end)
        if e.toe then pcall(function() e.toe:Destroy() end) end
        FS.prints[i] = nil
    end
    table.clear(FS.last); table.clear(FS.side)
    if FS.folder then pcall(function() FS.folder:Destroy() end); FS.folder = nil end
end

local function fsDrop(cf, col)
    if #FS.prints >= 220 then
        local old = table.remove(FS.prints, 1)
        if old then
            pcall(function() old.part:Destroy() end)
            if old.toe then pcall(function() old.toe:Destroy() end) end
        end
    end
    if not (FS.folder and FS.folder.Parent) then
        FS.folder = Instance.new("Folder")
        FS.folder.Name = "AirFlowFootsteps"
        FS.folder.Parent = workspace
    end
    local part = Instance.new("Part")
    part.Anchored = true; part.CanCollide = false
    part.CanQuery = false; part.CanTouch = false; part.CastShadow = false
    part.Size = Vector3.new(0.4, 0.07, 0.66)
    part.Material = Enum.Material.Neon
    part.Color = col; part.Transparency = 0.15
    part.CFrame = cf; part.Parent = FS.folder
    local sm = Instance.new("SpecialMesh", part); sm.MeshType = Enum.MeshType.Sphere

    local toe = Instance.new("Part")
    toe.Anchored = true; toe.CanCollide = false
    toe.CanQuery = false; toe.CanTouch = false; toe.CastShadow = false
    toe.Size = Vector3.new(0.26, 0.06, 0.2)
    toe.Material = Enum.Material.Neon
    toe.Color = col; toe.Transparency = 0.15
    toe.CFrame = cf * CFrame.new(0, 0, -0.46)
    toe.Parent = FS.folder
    local sm2 = Instance.new("SpecialMesh", toe); sm2.MeshType = Enum.MeshType.Sphere

    FS.prints[#FS.prints + 1] = { part = part, toe = toe, born = os.clock() }
end

local function fsHeartbeat()
    local now = os.clock()
    for i = #FS.prints, 1, -1 do
        local e = FS.prints[i]
        local age = now - e.born
        if age >= FS.LIFE or not e.part.Parent then
            pcall(function() e.part:Destroy() end)
            if e.toe then pcall(function() e.toe:Destroy() end) end
            table.remove(FS.prints, i)
        else
            local t = 0.15 + 0.85 * (age / FS.LIFE)
            e.part.Transparency = t
            if e.toe then e.toe.Transparency = t end
        end
    end
    if now - FS.AT < 0.08 then return end
    FS.AT = now

    local me = game.Players.LocalPlayer.Character
    for _, plr in ipairs(game.Players:GetPlayers()) do
        if plr ~= game.Players.LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local pos = hrp.Position
                local prev = FS.last[plr]
                if not prev then
                    FS.last[plr] = pos
                elseif (pos - prev).Magnitude >= 3.5 then
                    FS.last[plr] = pos
                    FS.RAY.FilterDescendantsInstances = { plr.Character, me, FS.folder }
                    local hit = workspace:Raycast(pos, Vector3.new(0, -8, 0), FS.RAY)
                    if hit then
                        local n = hit.Normal
                        local travel = pos - prev
                        local look = (travel.Magnitude > 0.5) and travel.Unit or hrp.CFrame.LookVector
                        local fwd = look - n * look:Dot(n)
                        fwd = (fwd.Magnitude > 1e-3) and fwd.Unit or Vector3.new(0, 0, -1)
                        local sideVec = fwd:Cross(n)
                        FS.side[plr] = not FS.side[plr]
                        local base = hit.Position + sideVec * (FS.side[plr] and 0.3 or -0.3) + n * 0.045
                        local role = getPlayerRole(plr)
                        fsDrop(CFrame.lookAt(base, base + fwd, n), fsTint(role))
                    end
                end
            end
        end
    end
end

local function fsEnable()
    if FS.enabled then return end
    FS.enabled = true
    FS.heartbeatConn = game:GetService("RunService").Heartbeat:Connect(fsHeartbeat)
end

local function fsDisable()
    if not FS.enabled then return end
    FS.enabled = false
    if FS.heartbeatConn then FS.heartbeatConn:Disconnect(); FS.heartbeatConn = nil end
    fsClear()
end

--==============================================================
-- Theme listener
--==============================================================
local function onThemeChanged()
    if not GE.enabled then return end
    local accent = getAccentColor()
    for _, hl in ipairs(GE.hlFolder:GetChildren()) do
        if hl.Name == "GunHL" then hl.OutlineColor = accent end
    end
    for _, bb in pairs(GE.labelStore) do
        local nameLbl = bb:FindFirstChild("NameLbl", true)
        local distLbl = bb:FindFirstChild("DistLbl", true)
        local stroke = bb:FindFirstChildOfClass("UIStroke")
        if nameLbl then nameLbl.TextColor3 = accent end
        if distLbl then distLbl.TextColor3 = accent end
        if stroke then stroke.Color = accent end
    end
end

