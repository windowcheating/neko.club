local function geRecordDeath(plr)
    local char = plr.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    GE.recentDeaths[#GE.recentDeaths + 1] = { player = plr, pos = hrp.Position, time = os.clock() }
    local now = os.clock()
    for i = #GE.recentDeaths, 1, -1 do
        if now - GE.recentDeaths[i].time > 20 then
            table.remove(GE.recentDeaths, i)
        end
    end
end

local function geFindOwner(gunPart)
    if not gunPart then return nil end
    local gp = gunPart:IsA("Model") and gunPart:FindFirstChildWhichIsA("BasePart") or (gunPart:IsA("BasePart") and gunPart or nil)
    if not gp then return nil end
    local now = os.clock()
    local best, bestDist = nil, 25
    for _, d in ipairs(GE.recentDeaths) do
        if now - d.time <= 20 then
            local dist = (d.pos - gp.Position).Magnitude
            if dist < bestDist then bestDist = dist; best = d.player end
        end
    end
    return best
end

local function geAssignOwner(highlight, bb, gunPart)
    if GE.ownerData[highlight] then return end
    local owner = geFindOwner(gunPart)
    if not owner then return end
    local data = { player = owner, avatarUrl = nil }
    GE.ownerData[highlight] = data
    local nameLbl = bb:FindFirstChild("NameLbl", true)
    if nameLbl then nameLbl.Text = owner.Name end
    task.spawn(function()
        local ok, url = pcall(function()
            return game.Players:GetUserThumbnailAsync(owner.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        end)
        if ok and url and GE.ownerData[highlight] == data then
            data.avatarUrl = url
            local av = bb:FindFirstChild("Avatar", true)
            if av then av.Image = url end
        end
    end)
end

