function API:Destroy()
    if atmos and atmos.Parent then atmos:Destroy() end
    atmos = nil
    if textureConn then textureConn:Disconnect(); textureConn = nil end
    removeTextures()
    if FFMapConn then FFMapConn:Disconnect(); FFMapConn = nil end
    restoreFFMap()
    if RTXConfig.Enabled then clearRTX() end
    if skyboxSpinConn then skyboxSpinConn:Disconnect(); skyboxSpinConn = nil end
    if Weather and Weather.destroy then pcall(Weather.destroy) end
end

