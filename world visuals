    local function newPart(name, parent)
        local pt = Instance.new("Part")
        pt.Name = name; pt.Anchored = true; pt.CanCollide = false
        pt.Locked = true; pt.Transparency = 1; pt.Massless = true
        pcall(function() pt.CanQuery = false end)
        pcall(function() pt.CanTouch = false end)
        pt.Parent = parent
        return pt
    end
    local function resolveCamera()
        local c = workspace.CurrentCamera; if c then camera = c end; return camera
    end
    local function shade(c, f)
        return Color3.new(math.clamp(c.R*f,0,1), math.clamp(c.G*f,0,1), math.clamp(c.B*f,0,1))
    end

    local function ensureRig()
        if folder and folder.Parent then return true end
        local cam = resolveCamera(); if not cam then return false end
