local function startSkyboxSpin()
    if skyboxSpinConn then skyboxSpinConn:Disconnect(); skyboxSpinConn = nil end
    skyboxSpinConn = Services.RunService.Heartbeat:Connect(function(dt)
        local sky = L:FindFirstChildOfClass("Sky")
        if not sky then return end
        killCelestialBodies(sky)
        sky.SkyboxOrientation = Vector3.new(0, (sky.SkyboxOrientation.Y + skyboxSpinSpeed * dt) % 360, 0)
    end)
end
function API:EnableSkyboxSpin(enabled)
    if enabled then startSkyboxSpin()
    else
        if skyboxSpinConn then skyboxSpinConn:Disconnect(); skyboxSpinConn = nil end
        local sky = L:FindFirstChildOfClass("Sky")
        if sky then pcall(function() sky.SkyboxOrientation = Vector3.new(0,0,0) end) end
    end
end
function API:SetSkyboxSpinSpeed(v) skyboxSpinSpeed = v end

