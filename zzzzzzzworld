    if enabled then startSkyboxSpin()
    else
        if skyboxSpinConn then skyboxSpinConn:Disconnect(); skyboxSpinConn = nil end
        local sky = L:FindFirstChildOfClass("Sky")
        if sky then pcall(function() sky.SkyboxOrientation = Vector3.new(0,0,0) end) end
