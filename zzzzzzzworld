-- WORLD TEXTURES
-- ============================================================
local function applyTexture(inst)
    local pack = TEXTURE_PACKS[currentTexturePack]; if not pack then return end
    if not (inst:IsA("MeshPart") or inst:IsA("Part")) then return end
    local tex = pack[inst.Material.Name]
    local isDefault = inst.Color == Color3.fromRGB(254,253,255)
    if tex or isDefault then
        if inst.Transparency >= 0.8 then return end
        if not textureRestores[inst] then
            textureRestores[inst] = inst.Color
            inst.Color = Color3.fromRGB(254,253,255)
        end
    end
end

local function applyTextures()
    for i = 1, #textureVariants do
        if textureVariants[i] then textureVariants[i]:Destroy(); textureVariants[i] = nil end
    end
    textureVariants = {}
    local matService = game:FindService("MaterialService"); if not matService then return end
    local pack = TEXTURE_PACKS[currentTexturePack]; if not pack then return end
    for name, url in pairs(pack) do
        if name ~= "Glass" then
            local variant = Instance.new("MaterialVariant")
            variant.ColorMap = url
            variant.MetalnessMap = url
            variant.NormalMap = url
            variant.RoughnessMap = url
            variant.BaseMaterial = Enum.Material[name]
            variant.Name = name
            variant.StudsPerTile = 5
            variant.Parent = matService
            table.insert(textureVariants, variant)
        end
    end
    for _, inst in ipairs(workspace:GetDescendants()) do applyTexture(inst) end
end

local function removeTextures()
    for i = 1, #textureVariants do pcall(function() textureVariants[i]:Destroy() end) end
    textureVariants = {}
    for inst, col in pairs(textureRestores) do
        pcall(function() inst.Color = col end)
        textureRestores[inst] = nil
    end
end

function API:EnableTextures(enabled)
    if enabled then
        applyTextures()
        if textureConn then textureConn:Disconnect() end
        textureConn = workspace.DescendantAdded:Connect(function(inst) applyTexture(inst) end)
    else
        if textureConn then textureConn:Disconnect(); textureConn = nil end
        removeTextures()
    end
end
function API:SetTexturePack(pack)
    currentTexturePack = pack
    if textureConn then removeTextures(); applyTextures() end
end

-- ============================================================
-- FORCEFIELD MAP
-- ============================================================
local function applyFFToPart(part)
    if not part:IsA("BasePart") then return end
    if part.Transparency >= 0.95 and part.CanCollide == false then return end
    if not FFMapConfig.CachedParts[part] then
        FFMapConfig.CachedParts[part] = {
            Material = part.Material, Color = part.Color, Transparency = part.Transparency,
        }
    end
    part.Material = Enum.Material.ForceField
    if FFMapConfig.ChangeColor then part.Color = FFMapConfig.Color end
    part.Transparency = FFMapConfig.Transparency
end

local function applyFFMap()
    local map = workspace:FindFirstChild("FFA_MAP") or workspace:FindFirstChild("Map")
    if not map then return end
    for _, inst in ipairs(map:GetDescendants()) do applyFFToPart(inst) end
    if FFMapConn then FFMapConn:Disconnect() end
    FFMapConn = map.DescendantAdded:Connect(function(inst)
        if FFMapConfig.Enabled then task.defer(function() applyFFToPart(inst) end) end
    end)
end

local function restoreFFMap()
    if FFMapConn then FFMapConn:Disconnect(); FFMapConn = nil end
    for part, data in pairs(FFMapConfig.CachedParts) do
        if part and part.Parent then
            pcall(function()
                part.Material = data.Material
                part.Color = data.Color
                part.Transparency = data.Transparency
            end)
        end
    end
    FFMapConfig.CachedParts = {}
end

function API:EnableFFMap(enabled)
    FFMapConfig.Enabled = enabled
    if enabled then applyFFMap() else restoreFFMap() end
end
function API:SetFFMapColor(c)
    FFMapConfig.Color = c
    if FFMapConfig.Enabled and FFMapConfig.ChangeColor then
        for part in pairs(FFMapConfig.CachedParts) do
            if part and part.Parent then part.Color = c end
        end
    end
end
function API:SetFFMapChangeColor(v)
    FFMapConfig.ChangeColor = v
    if FFMapConfig.Enabled then
        for part, data in pairs(FFMapConfig.CachedParts) do
            if part and part.Parent then
                if v then part.Color = FFMapConfig.Color else part.Color = data.Color end
            end
        end
    end
end
function API:SetFFMapTransparency(v)
    FFMapConfig.Transparency = v
    if FFMapConfig.Enabled then
        for part in pairs(FFMapConfig.CachedParts) do
            if part and part.Parent then part.Transparency = v end
        end
    end
end

-- ============================================================
-- RTX
-- ============================================================
local function addRTXHighlight(part)
    if part:IsA("BasePart") and not part:FindFirstChild("rtx_highlight") then
        local h = Instance.new("Highlight")
        h.Name = "rtx_highlight"; h.Adornee = part
        h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.FillTransparency = 1; h.OutlineTransparency = 0.9
        h.OutlineColor = Color3.fromRGB(0,0,0); h.Parent = part
    end
end

local function addRTXLamplight(part)
    if part:IsA("BasePart") and not part:FindFirstChild("RTX_Light") then
        local n = part.Name:lower()
        if n:find("lamp") or n:find("light") or n:find("bulb") or n:find("neon") then
            local l = Instance.new("PointLight")
            l.Name = "RTX_Light"; l.Brightness = 2.8; l.Range = 20
            l.Color = Color3.fromRGB(255,235,210); l.Shadows = true
            l.Parent = part
        end
    end
end

local function clearRTX()
    if RTXTimeForceConn then RTXTimeForceConn:Disconnect(); RTXTimeForceConn = nil end
    if RTXDescAddedConn then RTXDescAddedConn:Disconnect(); RTXDescAddedConn = nil end
    for _, c in ipairs(L:GetChildren()) do
        if c.Name == "RTX_Sky" or c.Name == "RTX_SunRays" or c.Name == "RTX_Bloom"
            or c.Name == "RTX_CC" or c.Name == "RTX_Blur" or c.Name == "RTX_DoF" then
            c:Destroy()
        end
    end
    for _, inst in ipairs(workspace:GetDescendants()) do
        local hl = inst:FindFirstChild("rtx_highlight"); if hl then hl:Destroy() end
        if inst:IsA("BasePart") then
            local l = inst:FindFirstChild("RTX_Light"); if l then l:Destroy() end
        end
    end
    if RTXOrig.Technology then
        L.Technology = RTXOrig.Technology
        L.ClockTime = RTXOrig.ClockTime
        L.Brightness = RTXOrig.Brightness
        L.GlobalShadows = RTXOrig.GlobalShadows
        L.EnvironmentDiffuseScale = RTXOrig.EnvironmentDiffuseScale
        L.EnvironmentSpecularScale = RTXOrig.EnvironmentSpecularScale
        L.Ambient = RTXOrig.Ambient
        L.OutdoorAmbient = RTXOrig.OutdoorAmbient
        L.FogColor = RTXOrig.FogColor
        L.FogStart = RTXOrig.FogStart
        L.FogEnd = RTXOrig.FogEnd
        L.ColorShift_Top = RTXOrig.ColorShift_Top
        L.ColorShift_Bottom = RTXOrig.ColorShift_Bottom
    end
end

local function updateRTXColor()
    if not RTXConfig.Enabled then return end
    L.FogColor = RTXConfig.Color
    local cc = L:FindFirstChild("RTX_CC")
    if cc and cc:IsA("ColorCorrectionEffect") then cc.TintColor = RTXConfig.Color end
end

local function applyRTX()
    clearRTX()
    RTXOrig.Technology = L.Technology
    RTXOrig.ClockTime = L.ClockTime
    RTXOrig.Brightness = L.Brightness
    RTXOrig.GlobalShadows = L.GlobalShadows
    RTXOrig.EnvironmentDiffuseScale = L.EnvironmentDiffuseScale
    RTXOrig.EnvironmentSpecularScale = L.EnvironmentSpecularScale
    RTXOrig.Ambient = L.Ambient
    RTXOrig.OutdoorAmbient = L.OutdoorAmbient
    RTXOrig.FogColor = L.FogColor
    RTXOrig.FogStart = L.FogStart
    RTXOrig.FogEnd = L.FogEnd
    RTXOrig.ColorShift_Top = L.ColorShift_Top
    RTXOrig.ColorShift_Bottom = L.ColorShift_Bottom

    L.Technology = Enum.Technology.Future
    L.ClockTime = 18.5
    L.Brightness = 2.2
    L.GlobalShadows = true
    L.EnvironmentDiffuseScale = 0.8
    L.EnvironmentSpecularScale = 1
    L.Ambient = Color3.fromRGB(75,60,65)
    L.OutdoorAmbient = Color3.fromRGB(120,100,105)
    L.FogColor = RTXConfig.Color
    L.FogStart = 0; L.FogEnd = 700
    L.ColorShift_Top = Color3.fromRGB(35,25,28)
    L.ColorShift_Bottom = Color3.fromRGB(20,15,18)

    RTXTimeForceConn = L:GetPropertyChangedSignal("ClockTime"):Connect(function()
        if L.ClockTime ~= 18.5 then L.ClockTime = 18.5 end
    end)

    local sky = Instance.new("Sky"); sky.Name = "RTX_Sky"
    sky.SkyboxBk = "rbxassetid://160405144"; sky.SkyboxDn = "rbxassetid://160405144"
    sky.SkyboxFt = "rbxassetid://160405144"; sky.SkyboxLf = "rbxassetid://160405144"
    sky.SkyboxRt = "rbxassetid://160405144"; sky.SkyboxUp = "rbxassetid://160405144"
    sky.MoonAngularSize = 0; sky.SunAngularSize = 0
    sky.StarCount = 2500; sky.CelestialBodiesShown = false
    sky.Parent = L

    local rays = Instance.new("SunRaysEffect"); rays.Name = "RTX_SunRays"
    rays.Intensity = 0; rays.Spread = 0.2; rays.Parent = L
    local cc = Instance.new("ColorCorrectionEffect"); cc.Name = "RTX_CC"
    cc.Contrast = 0.08; cc.Saturation = 0.05; cc.Brightness = 0.01
    cc.TintColor = RTXConfig.Color; cc.Parent = L
    local blur = Instance.new("BlurEffect"); blur.Name = "RTX_Blur"
    blur.Size = 0; blur.Parent = L
    local dof = Instance.new("DepthOfFieldEffect"); dof.Name = "RTX_DoF"
    dof.InFocusRadius = 160; dof.FocusDistance = 75
    dof.NearIntensity = 0.1; dof.FarIntensity = 0.2; dof.Parent = L

    Services.TweenService:Create(rays, TweenInfo.new(1), { Intensity = 0.1 }):Play()
    Services.TweenService:Create(blur, TweenInfo.new(1), { Size = 1 }):Play()

    for _, inst in ipairs(workspace:GetDescendants()) do addRTXHighlight(inst); addRTXLamplight(inst) end
    RTXDescAddedConn = workspace.DescendantAdded:Connect(function(inst)
        task.defer(function()
            if RTXConfig.Enabled then addRTXHighlight(inst); addRTXLamplight(inst) end
        end)
    end)
end

function API:EnableRTX(enabled)
    RTXConfig.Enabled = enabled
    if enabled then applyRTX() else clearRTX() end
end
function API:SetRTXColor(c) RTXConfig.Color = c; updateRTXColor() end

