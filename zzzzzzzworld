local lightingState = {
    enabled = false, type = "shadowmap", worldTime = false, hour = 4.5,
    ambient = false, ambientColor = orig.Ambient, outdoorColor = orig.Outdoor,
}
local atmState = {
    enabled = false, color = Color3.new(1,1,1), decay = Color3.fromRGB(120,120,120),
    haze = 1, glare = 10, offset = 0, density = 0.35,
}
local skyboxState = { enabled = false, type = "realistic" }

local function killCelestialBodies(sky)
    if not sky then return end
    pcall(function() sky.CelestialBodiesShown = false end)
    pcall(function() sky.SunAngularSize = 0 end)
    pcall(function() sky.MoonAngularSize = 0 end)
end

local function applySkybox(name)
    local sky = L:FindFirstChildOfClass("Sky")
    if not sky then sky = Instance.new("Sky"); sky.Parent = L end
    local data = SKYBOXES[name]; if not data then return end
    sky.SkyboxBk = data.SkyboxBk or ""
    sky.SkyboxDn = data.SkyboxDn or ""
    sky.SkyboxFt = data.SkyboxFt or ""
    sky.SkyboxLf = data.SkyboxLf or ""
    sky.SkyboxRt = data.SkyboxRt or ""
    sky.SkyboxUp = data.SkyboxUp or ""
    killCelestialBodies(sky)
end

local function updateVisuals()
    if lightingState.enabled then
        local tech = ({
            compatibility = Enum.Technology.Compatibility,
            shadowmap     = Enum.Technology.ShadowMap,
            future        = Enum.Technology.Future,
            voxel         = Enum.Technology.Voxel,
        })[lightingState.type] or Enum.Technology.ShadowMap
        if L.Technology ~= tech then L.Technology = tech end
    elseif L.Technology ~= orig.Technology then
        L.Technology = orig.Technology
    end
    if lightingState.worldTime and L.ClockTime ~= lightingState.hour then L.ClockTime = lightingState.hour end
    if lightingState.ambient then
        if L.Ambient ~= lightingState.ambientColor then L.Ambient = lightingState.ambientColor end
        if L.OutdoorAmbient ~= lightingState.outdoorColor then L.OutdoorAmbient = lightingState.outdoorColor end
    end
    
    -- Atmosphere
    if atmState.enabled then
        if not atmos or not atmos.Parent then atmos = Instance.new("Atmosphere"); atmos.Parent = L end
        atmos.Color = atmState.color; atmos.Decay = atmState.decay
        atmos.Haze = atmState.haze; atmos.Glare = atmState.glare
        atmos.Offset = atmState.offset; atmos.Density = atmState.density
    elseif atmos then
        atmos:Destroy(); atmos = nil
    end
    
    -- Screen Adjustments
    if not screenCC or not screenCC.Parent then
        screenCC = Instance.new("ColorCorrectionEffect")
        screenCC.Name = "Neko_ScreenCC"
        screenCC.Parent = L
    end
    
    -- Skybox
    if skyboxState.enabled then
        local sky = L:FindFirstChildOfClass("Sky")
        local data = SKYBOXES[skyboxState.type]
        if not sky or (data and sky.SkyboxBk ~= data.SkyboxBk) then applySkybox(skyboxState.type) end
        if sky then killCelestialBodies(sky) end
    else
        local sky = L:FindFirstChildOfClass("Sky")
        if orig.Sky then
            if sky and sky ~= orig.Sky then sky:Destroy() end
            if orig.Sky.Parent ~= L then orig.Sky.Parent = L end
        end
    end
end

Services.RunService.Heartbeat:Connect(updateVisuals)
LocalPlayer.CharacterAdded:Connect(function() task.wait(0.2); updateVisuals() end)

