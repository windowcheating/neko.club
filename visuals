local KB_RowInstances = {}

for _, feature in ipairs(TrackedKeybinds) do
    local row = Instance.new("Frame", rowsHolder)
    row.Size = UDim2.new(1, 0, 0, 16); row.BackgroundTransparency = 1; row.Visible = false
    local name = Instance.new("TextLabel", row)
    name.Size = UDim2.new(0.65, 0, 1, 0); name.BackgroundTransparency = 1
    name.Text = feature.Name; name.Font = Enum.Font.GothamMedium; name.TextSize = 11
    name.TextColor3 = Color3.fromRGB(240, 228, 232); name.TextXAlignment = Enum.TextXAlignment.Left
    local status = Instance.new("TextLabel", row)
    status.Size = UDim2.new(0.35, 0, 1, 0); status.Position = UDim2.new(0.65, 0, 0, 0)
    status.BackgroundTransparency = 1; status.Font = Enum.Font.GothamMedium; status.TextSize = 11
    status.Text = "["..feature.GetKey().."]"; status.TextXAlignment = Enum.TextXAlignment.Right
    KB_RowInstances[feature.Name] = { Frame = row, StatusLabel = status, NameLabel = name }
end

local function updateKeybindTheme()
    local theme = Library.Theme; if not theme then return end
    mainCard.BackgroundColor3 = theme.Background
    s1.Color = theme.Background
    local activeAccent = theme.Accent
    title.TextColor3 = Color3.fromRGB(240, 228, 232)
    sep.BackgroundColor3 = activeAccent
    for _, inst in pairs(KB_RowInstances) do inst.StatusLabel.TextColor3 = activeAccent end
end

table.insert(Library._themeListeners, updateKeybindTheme)
task.spawn(function() task.wait(1); updateKeybindTheme() end)

task.spawn(function()
    while task.wait(0.04) do
        local active = 0
        for _, feature in ipairs(TrackedKeybinds) do
            local inst = KB_RowInstances[feature.Name]
            if inst then
                if feature.IsActive() then
                    active = active + 1
                    inst.StatusLabel.Text = "["..feature.GetKey().."]"
                    inst.Frame.Visible = true
                else
                    inst.Frame.Visible = false
                end
            end
        end
        local targetH = active == 0 and 28 or 34 + active * 19
        game:GetService("TweenService"):Create(mainCard,
            TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, 180, 0, targetH) }):Play()
    end
end)
