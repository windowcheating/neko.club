local function safeCall(mod, method, label)
    if not mod then warn("["..label.."] module not loaded"); return end
    local ok, err = pcall(function() mod[method](mod) end)
    if not ok then warn("["..label.."] "..method..": "..tostring(err)) end
end
local function safeSet(mod, method, val, label)
    if not mod then return end
    pcall(function() mod[method](mod, val) end)
end

