local decorator = nil
local decoratorVisible = true

local cachedAssets = {}
local decorOptions = {
    ["waifu"] = { url = "https://files.catbox.moe/z7zvgv.png", size = UDim2.fromOffset(180, 120), position = UDim2.new(1, -10, 0, 18) },
    ["mei mei"] = { url = "https://files.catbox.moe/sysmjw.png", size = UDim2.fromOffset(130, 130), position = UDim2.new(1, -25, 0, -2) }
}

local function downloadAsset(name)
    local opt = decorOptions[name]; if not opt then return end
    if type(writefile) == "function" and type(isfile) == "function" and type(getcustomasset) == "function" then
        local folder = "AirFlowDecorator"
        if type(isfolder) == "function" and type(makefolder) == "function" and not isfolder(folder) then makefolder(folder) end
        local fileName = (name == "waifu" and "customgirl2.png" or "meimei.png")
        local path = folder .. "/" .. fileName
        if not isfile(path) then
            local ok, body = pcall(function() return game:HttpGet(opt.url) end)
            if ok and body then writefile(path, body) end
        end
        if isfile(path) then cachedAssets[name] = getcustomasset(path) end
    else
        cachedAssets[name] = opt.url
    end
end

task.spawn(function() downloadAsset("waifu"); downloadAsset("mei mei") end)

local function setDecorator(name)
    local opt = decorOptions[name]; if not opt or not decorator then return end
    decorator.Size = opt.size
    decorator.Position = opt.position
    decorator.Image = cachedAssets[name] or opt.url
end

