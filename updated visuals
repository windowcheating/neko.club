-- ============================================================
local CH = { enabled = false, mode = "Shoulder", color = Color3.fromHex("#706669") }
local CH_PATH = "NLAssets/charizard_cursor.webp"
local CH_URL  = "https://files.catbox.moe/nytp24.webp"

local function fetchCharizard()
    local get = getcustomasset or getsynasset
    if not get then return "" end
    if not isfolder("NLAssets") then makefolder("NLAssets") end
    if not isfile(CH_PATH) then
        local ok, body = pcall(function() return game:HttpGet(CH_URL) end)
        if ok and body and #body > 100 then writefile(CH_PATH, body) end
    end
    if isfile(CH_PATH) then return get(CH_PATH) end
    return ""
end

if getgenv().__NL_CharizardGui then pcall(function() getgenv().__NL_CharizardGui:Destroy() end) end
local cGui = Instance.new("ScreenGui")
cGui.Name = "NL_Charizard2D"
cGui.ResetOnSpawn = false
cGui.IgnoreGuiInset = true
local cOk = pcall(function() cGui.Parent = Services.CoreGui end)
if not cOk then cGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
getgenv().__NL_CharizardGui = cGui

local holder = Instance.new("Frame")
holder.Name = "CharizardHolder"
holder.BackgroundTransparency = 1
holder.BorderSizePixel = 0
holder.ClipsDescendants = true
holder.AnchorPoint = Vector2.new(0.5, 0.5)
holder.Size = UDim2.fromOffset(80, 80)
holder.Visible = false
holder.Parent = cGui

local sheet = Instance.new("ImageLabel")
sheet.Name = "Sheet"
sheet.BackgroundTransparency = 1
sheet.BorderSizePixel = 0
sheet.ResampleMode = Enum.ResamplerMode.Pixelated
sheet.ScaleType = Enum.ScaleType.Stretch
sheet.Position = UDim2.new(0,0,0,0)
sheet.Parent = holder

local chFrame, chTimer = 0, 0
local CH_W, CH_H, CH_FW, CH_COLS, CH_TOTAL = 1040, 910, 130, 8, 51
local CH_SIZE, CH_FPS = 80, 0.045
local chSpritesheet = true

task.spawn(function()
    task.wait(0.2)
    local a = fetchCharizard()
    if a == "" then
        warn("[Charizard] asset failed to load — the sprite URL may be broken")
        return
    end
    sheet.Image = a
    local lower = CH_URL:lower()
    if lower:find("%.webp$") or lower:find("%.gif$") then
        chSpritesheet = false
    end
    if chSpritesheet then
        sheet.Size = UDim2.fromOffset(CH_W * (CH_SIZE / CH_FW), CH_H * (CH_SIZE / CH_FW))
    else
        sheet.Size = UDim2.fromOffset(CH_SIZE, CH_SIZE)
        sheet.Position = UDim2.new(0, 0, 0, 0)
        holder.ClipsDescendants = false
    end
end)

getgenv().__NL_CharizardConn = Services.RunService.RenderStepped:Connect(function(dt)
    if not CH.enabled then holder.Visible = false; return end
    local screenPos
    local mode = CH.mode
    if mode == "Follow Target" then
        local target = (getgenv().Config and getgenv().Config.ForceHit and getgenv().Config.ForceHit.Target)
            or (getgenv().KillAura and getgenv().KillAura.CurrentTarget)
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local sp, on = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
                if on then screenPos = Vector2.new(sp.X, sp.Y) end
            end
        end
    elseif mode == "Above Tool" then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            local h = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
            if h then
                local sp, on = cam:WorldToViewportPoint(h.Position + Vector3.new(0, 1.2, 0))
                if on then screenPos = Vector2.new(sp.X, sp.Y) end
            end
        end
    elseif mode == "Shoulder" then
        local char = LocalPlayer.Character
        local shoulder = char and (char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm"))
        if shoulder then
            local wp = shoulder.Position + Vector3.new(0, 1.4, 0) - shoulder.CFrame.LookVector * 0.4
            local sp, on = cam:WorldToViewportPoint(wp)
            if on then screenPos = Vector2.new(sp.X, sp.Y) end
        end
    elseif mode == "Mouse" then
        local m = Services.UserInputService:GetMouseLocation()
        screenPos = Vector2.new(m.X, m.Y)
    end
    if not screenPos then
        local m = Services.UserInputService:GetMouseLocation()
        screenPos = Vector2.new(m.X, m.Y)
    end

    holder.Visible = true
    sheet.ImageColor3 = CH.color
    holder.Size = UDim2.fromOffset(CH_SIZE, CH_SIZE)
    holder.Position = UDim2.fromOffset(screenPos.X, screenPos.Y)

    if chSpritesheet then
        chTimer = chTimer + dt
        while chTimer >= CH_FPS do
            chTimer = chTimer - CH_FPS
            chFrame = (chFrame + 1) % CH_TOTAL
        end
        local col = chFrame % CH_COLS
        local row = math.floor(chFrame / CH_COLS)
        local scale = CH_SIZE / CH_FW
        sheet.Size = UDim2.fromOffset(CH_W * scale, CH_H * scale)
        sheet.Position = UDim2.fromOffset(-col * CH_SIZE, -row * CH_SIZE)
    end
end)

function API:EnableCharizardCursor()  CH.enabled = true end
