-- visuals.lua — raw feature source (no UI, no toggles)
-- Ported 1:1 from NeverLarp's Self Material / Tool Material / Particle Aura /
-- Tool Aura / Cursor Pet (Oneko) / Charizard Cursor / Crosshair implementations.
-- Consumer (AirFlow hub) wires the UI and calls the Enable/Disable/Set methods.

local API = {}

local Services = {
    Players          = game:GetService("Players"),
    RunService       = game:GetService("RunService"),
    UserInputService = game:GetService("UserInputService"),
    TweenService     = game:GetService("TweenService"),
    CoreGui          = game:GetService("CoreGui"),
}
local LocalPlayer = Services.Players.LocalPlayer

local DEFAULT_ACCENT = Color3.fromHex and Color3.fromHex("#9791df") or Color3.fromRGB(0x97, 0x91, 0xdf)
local function accent()
    local nl = getgenv().NeverLose
    return (nl and nl.AccentColor) or DEFAULT_ACCENT
end

-- ============================================================
-- 1) SELF MATERIAL
-- ============================================================
local SM = {
    enabled = false,
    material = "Neon",
    color = accent(),
    transparency = 0,
    originalData = {},
    savedClothes = {},
    savedFaces = {},
    savedBodyColors = nil,
    wireframeBoxes = {},
}
local targetBodyParts = {
    Head=true, Torso=true, UpperTorso=true, LowerTorso=true,
    LeftArm=true, RightArm=true, LeftLeg=true, RightLeg=true,
    LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
    RightUpperArm=true, RightLowerArm=true, RightHand=true,
    LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
    RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
}

local function isKorblox(char)
    if not char then return false end
    local rll = char:FindFirstChild("RightLowerLeg")
    local rf  = char:FindFirstChild("RightFoot")
    if rll and rll.Transparency >= 0.9 then return true end
    if rf  and rf.Transparency  >= 0.9 then return true end
    return false
end

local function smClearWireframe()
    for _, b in ipairs(SM.wireframeBoxes) do
        pcall(function() if b and b.Parent then b:Destroy() end end)
    end
    SM.wireframeBoxes = {}
end

local function smHideClothes(char)
    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
            table.insert(SM.savedClothes, obj)
            obj.Parent = nil
        end
    end
end

local function smRestoreClothes(char)
    for _, obj in ipairs(SM.savedClothes) do
        if obj and obj:IsA("Instance") and char then obj.Parent = char end
    end
    SM.savedClothes = {}
end

local function smHideFace(char)
    local head = char and char:FindFirstChild("Head")
    if not head then return end
    for _, obj in ipairs(head:GetDescendants()) do
        if obj:IsA("Decal") then
            if SM.savedFaces[obj] == nil then SM.savedFaces[obj] = obj.Transparency end
            obj.Transparency = 1
        end
    end
end

local function smRestoreFace()
    for d, t in pairs(SM.savedFaces) do
        if d and d.Parent then pcall(function() d.Transparency = t end) end
    end
    SM.savedFaces = {}
end

local function smApplyBodyColors(char, color)
    local bc = char and char:FindFirstChildOfClass("BodyColors")
    if not bc then return end
    if not SM.savedBodyColors then
        SM.savedBodyColors = {
            HeadColor3=bc.HeadColor3, TorsoColor3=bc.TorsoColor3,
            LeftArmColor3=bc.LeftArmColor3, RightArmColor3=bc.RightArmColor3,
            LeftLegColor3=bc.LeftLegColor3, RightLegColor3=bc.RightLegColor3,
        }
    end
    bc.HeadColor3 = color; bc.TorsoColor3 = color
    bc.LeftArmColor3 = color; bc.RightArmColor3 = color
    bc.LeftLegColor3 = color; bc.RightLegColor3 = color
end

local function smRestoreBodyColors(char)
    local bc = char and char:FindFirstChildOfClass("BodyColors")
    local s = SM.savedBodyColors
    if bc and s then
        bc.HeadColor3 = s.HeadColor3; bc.TorsoColor3 = s.TorsoColor3
        bc.LeftArmColor3 = s.LeftArmColor3; bc.RightArmColor3 = s.RightArmColor3
        bc.LeftLegColor3 = s.LeftLegColor3; bc.RightLegColor3 = s.RightLegColor3
    end
    SM.savedBodyColors = nil
end

local function smBackup(part)
    if not SM.originalData[part] then
        local mesh = part:FindFirstChildOfClass("SpecialMesh")
        SM.originalData[part] = {
            Material = part.Material, Color = part.Color, Transparency = part.Transparency,
            TextureID = part:IsA("MeshPart") and part.TextureID or nil,
            MeshTexture = mesh and mesh.TextureId or nil,
        }
    end
end

local function smApplyToPart(part, color)
    if SM.material == "Wireframe" then
        part.Transparency = 1
        if part:IsA("MeshPart") then part.TextureID = "" end
        local mesh = part:FindFirstChildOfClass("SpecialMesh")
        if mesh then mesh.TextureId = "" end
        local box = Instance.new("SelectionBox")
        box.Name = "SM_Wireframe"
        box.Adornee = part
        box.Color3 = color
        box.SurfaceTransparency = 1
        box.LineThickness = 0.01
        box.Parent = part
        table.insert(SM.wireframeBoxes, box)
    else
        part.Material = Enum.Material[SM.material] or Enum.Material.Neon
        part.Color = color
        if part:IsA("MeshPart") then part.TextureID = "" end
        local mesh = part:FindFirstChildOfClass("SpecialMesh")
        if mesh then mesh.TextureId = "" end
        local sa = part:FindFirstChildOfClass("SurfaceAppearance")
        if sa then sa:Destroy() end
        local trans = SM.transparency
        if SM.material == "Glass" or SM.material == "ForceField" then
            if trans <= 0 then trans = (SM.material == "Glass") and 0.25 or 0.3 end
        end
        part.Transparency = trans
    end
end

local function smApply()
    if not SM.enabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    smClearWireframe()
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and targetBodyParts[part.Name] then smBackup(part)
        elseif part:IsA("Accessory") then
            for _, d in ipairs(part:GetDescendants()) do
                if d:IsA("BasePart") then smBackup(d) end
            end
        end
    end
    smHideClothes(char); smHideFace(char); smApplyBodyColors(char, SM.color)
    local korblox = isKorblox(char)
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") and targetBodyParts[part.Name] then
            local orig = SM.originalData[part]
            local hidden = orig and orig.Transparency >= 0.9
            local kp = korblox and (part.Name == "RightLowerLeg" or part.Name == "RightFoot")
            if hidden or kp then
                part.Transparency = 1
                if part:IsA("MeshPart") then part.TextureID = "" end
            else
                smApplyToPart(part, SM.color)
            end
        end
    end
    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("Accessory") then
            for _, d in ipairs(part:GetDescendants()) do
                if d:IsA("BasePart") then
                    local orig = SM.originalData[d]
                    if orig and orig.Transparency >= 0.9 then d.Transparency = 1
                    else smApplyToPart(d, SM.color) end
                end
            end
        end
    end
end

local function smRestore()
    local char = LocalPlayer.Character
    smClearWireframe()
    if char then
        smRestoreClothes(char); smRestoreFace()
        for part, data in pairs(SM.originalData) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material; part.Color = data.Color
                    part.Transparency = data.Transparency
                    if part:IsA("MeshPart") and data.TextureID then part.TextureID = data.TextureID end
                    local mesh = part:FindFirstChildOfClass("SpecialMesh")
                    if mesh and data.MeshTexture then mesh.TextureId = data.MeshTexture end
                end)
            end
        end
    end
    smRestoreBodyColors(char)
    if isKorblox(char) and char then
        local rll = char:FindFirstChild("RightLowerLeg")
        local rf  = char:FindFirstChild("RightFoot")
        if rll then rll.Transparency = 1 end
        if rf  then rf.Transparency  = 1 end
    end
    SM.originalData = {}
end

function API:EnableSelfMaterial()  SM.enabled = true;  smApply() end
function API:DisableSelfMaterial() SM.enabled = false; smRestore() end
function API:ToggleSelfMaterial()  if SM.enabled then self:DisableSelfMaterial() else self:EnableSelfMaterial() end end
function API:IsSelfMaterialEnabled() return SM.enabled end
function API:SetSelfMaterialMaterial(m) SM.material = m; if SM.enabled then smApply() end end
function API:SetSelfMaterialColor(c)    SM.color = c;    if SM.enabled then smApply() end end
function API:SetSelfMaterialTransparency(t) SM.transparency = t; if SM.enabled then smApply() end end

-- ============================================================
-- 2) TOOL MATERIAL
-- ============================================================
local TM = {
    enabled = false,
    material = "Neon",
    color = accent(),
    transparency = 0,
    originalData = {},
    shellData = {},
    charConns = {},
}

local function tmWipe(clone)
    pcall(function() if clone:IsA("MeshPart") then clone.TextureID = "" end end)
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("SurfaceAppearance") or d:IsA("Decal") or d:IsA("Texture") then d:Destroy()
        elseif d:IsA("SpecialMesh") then d.TextureId = "" end
    end
end

local function tmClearForTool(tool)
    if not tool then return end
    local entry = TM.shellData[tool]
    if entry then
        for _, s in ipairs(entry) do if s and s.Parent then s:Destroy() end end
    end
    TM.shellData[tool] = nil
end

local function tmClearAll()
    for tool in pairs(TM.shellData) do tmClearForTool(tool) end
    TM.shellData = {}
    TM.originalData = {}
end

local function tmMakeShells(tool)
    if not tool or not tool:IsA("Tool") then return end
    if TM.shellData[tool] then return end
    local shells = {}
    TM.shellData[tool] = shells
    for _, part in ipairs(tool:GetDescendants()) do
        if part:IsA("BasePart") then
            if not TM.originalData[part] then TM.originalData[part] = { Transparency = part.Transparency } end
            local shell = part:Clone()
            shell.Name = "NL_Shell_" .. part.Name
            shell.CanCollide = false; shell.CanQuery = false; shell.CanTouch = false
            shell.Massless = true; shell.Anchored = false; shell.CastShadow = false
            shell.Transparency = 0
            tmWipe(shell)
            shell.Material = Enum.Material[TM.material] or Enum.Material.Neon
            shell.Color = TM.color
            local trans = TM.transparency
            if TM.material == "ForceField" and trans <= 0 then trans = 0.35 end
            shell.Transparency = trans
            shell.Size = part.Size + Vector3.new(0.02, 0.02, 0.02)
            shell.Parent = part
            shell.CFrame = part.CFrame
            local weld = Instance.new("WeldConstraint")
            weld.Part0 = part; weld.Part1 = shell; weld.Parent = shell
            part.Transparency = 1
            table.insert(shells, shell)
        end
    end
end

local function tmUpdateStyle(tool)
    local shells = TM.shellData[tool]
    if not shells then return end
    for _, shell in ipairs(shells) do
        if shell and shell.Parent then
            shell.Material = Enum.Material[TM.material] or Enum.Material.Neon
            shell.Color = TM.color
            local trans = TM.transparency
            if TM.material == "ForceField" and trans <= 0 then trans = 0.35 end
            shell.Transparency = trans
        end
    end
end

local function tmApplyToTool(tool)
    if not tool or not tool:IsA("Tool") then return end
    if TM.enabled then
        if TM.shellData[tool] then tmUpdateStyle(tool) else tmMakeShells(tool) end
    else tmClearForTool(tool) end
end

local function tmApplyAll()
    local char = LocalPlayer.Character
    if char then for _, c in ipairs(char:GetChildren()) do if c:IsA("Tool") then tmApplyToTool(c) end end end
    local bp = LocalPlayer.Backpack
    if bp then for _, c in ipairs(bp:GetChildren()) do if c:IsA("Tool") then tmApplyToTool(c) end end end
end

local function tmHookChar(char)
    if TM.charConns[char] then return end
    TM.charConns[char] = true
    char.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.2); tmApplyToTool(c) end end)
    char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then tmClearForTool(c) end end)
end

if LocalPlayer.Character then tmHookChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(function(c) task.wait(1); tmHookChar(c); tmApplyAll() end)
if LocalPlayer.Backpack then
    LocalPlayer.Backpack.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.wait(0.2); tmApplyToTool(c) end end)
end
LocalPlayer.CharacterRemoving:Connect(tmClearAll)

task.spawn(function()
    while task.wait(0.5) do if TM.enabled then tmApplyAll() end end
end)

function API:EnableToolMaterial()  TM.enabled = true;  tmApplyAll() end
function API:DisableToolMaterial() TM.enabled = false; tmClearAll() end
function API:ToggleToolMaterial()  if TM.enabled then self:DisableToolMaterial() else self:EnableToolMaterial() end end
function API:IsToolMaterialEnabled() return TM.enabled end
function API:SetToolMaterialMaterial(m) TM.material = m; if TM.enabled then tmApplyAll() end end
function API:SetToolMaterialColor(c)    TM.color = c;    if TM.enabled then tmApplyAll() end end
function API:SetToolMaterialTransparency(t) TM.transparency = t; if TM.enabled then tmApplyAll() end end

-- ============================================================
-- 3) PARTICLE AURA
-- ============================================================
local PA = { enabled = false, color = accent(), currentAura = "angel", particles = {}, auraObjects = {}, charConn = nil }
local AURA_IDS = {
    starlight = "rbxassetid://134645216613107",
    heavenly  = "rbxassetid://139300897520961",
    ribbon    = "rbxassetid://132069507632161",
    sakura    = "rbxassetid://81755778619404",
    angel     = "rbxassetid://97658130917593",
    wind      = "rbxassetid://80694081850877",
    flow      = "rbxassetid://119913533725648",
    star      = "rbxassetid://73754563740680",
}

local function paDestroy()
    for _, p in ipairs(PA.particles) do pcall(function() p:Destroy() end) end
    PA.particles = {}
end

local function paGetModel(name)
    if PA.auraObjects[name] then return PA.auraObjects[name] end
    local id = AURA_IDS[name]; if not id then return nil end
    local ok, model = pcall(function() return game:GetObjects(id)[1] end)
    if ok and model then PA.auraObjects[name] = model; return model end
    return nil
end

local function paApply()
    paDestroy()
    local char = LocalPlayer.Character
    if not char or not PA.enabled then return end
    local model = paGetModel(PA.currentAura); if not model then return end
    local clone = model:Clone()
    local seq = ColorSequence.new(PA.color)
    for _, d in ipairs(clone:GetDescendants()) do
        if d.ClassName == "PointLight" then d.Color = PA.color
        elseif d.ClassName == "ParticleEmitter" or d.ClassName == "Beam" or d.ClassName == "Trail" then d.Color = seq end
    end
    for _, child in ipairs(clone:GetChildren()) do
        local bodyPart = char:FindFirstChild(child.Name)
        if bodyPart then
            for _, sub in ipairs(child:GetChildren()) do
                sub.Parent = bodyPart; table.insert(PA.particles, sub)
            end
        end
    end
    clone:Destroy()
end

function API:EnableParticleAura()
    PA.enabled = true; paApply()
    if PA.charConn then PA.charConn:Disconnect() end
    PA.charConn = LocalPlayer.CharacterAdded:Connect(function() task.wait(0.5); paApply() end)
end
function API:DisableParticleAura()
    PA.enabled = false
    if PA.charConn then PA.charConn:Disconnect(); PA.charConn = nil end
    paDestroy()
end
function API:ToggleParticleAura() if PA.enabled then self:DisableParticleAura() else self:EnableParticleAura() end end
function API:IsParticleAuraEnabled() return PA.enabled end
function API:SetParticleAuraColor(c) PA.color = c; if PA.enabled then paApply() end end
function API:SetParticleAuraType(t)  PA.currentAura = t; if PA.enabled then paApply() end end

-- ============================================================
-- 4) TOOL AURA
-- ============================================================
local TA = { enabled = false, color = accent(), rateMultiplier = 0.1, particles = {}, charConns = {} }

local function taClear()
    for _, p in ipairs(TA.particles) do pcall(function() if p and p.Parent then p:Destroy() end end) end
    TA.particles = {}
end

local function taUpdateColor()
    for _, p in ipairs(TA.particles) do
        if p and p:IsA("ParticleEmitter") then pcall(function() p.Color = ColorSequence.new(TA.color) end) end
    end
end

local function taCreateOnPart(parent)
    if not TA.enabled then return end
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxassetid://10927170198"
    e.LightEmission = -5; e.Brightness = 10; e.ZOffset = 1; e.LightInfluence = 0
    e.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
    e.Color = ColorSequence.new(TA.color)
    e.EmissionDirection = Enum.NormalId.Top
    e.Lifetime = NumberRange.new(0.5)
    e.Rotation = NumberRange.new(0, 360)
    e.RotSpeed = NumberRange.new(1250)
    e.Speed = NumberRange.new(0.165)
    e.SpreadAngle = Vector2.new(-360, 360)
    pcall(function()
        e.Shape = Enum.ParticleEmitterShape.Box
        e.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
        e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
    end)
    e.Rate = 49 * TA.rateMultiplier
    e.Enabled = true
    e.Parent = parent
    table.insert(TA.particles, e)
end

local function taApply(tool)
    taClear()
    if not TA.enabled then return end
    local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
    if handle then taCreateOnPart(handle) end
end

local function taHook(char)
    if TA.charConns[char] then return end
    TA.charConns[char] = true
    char.ChildAdded:Connect(function(c) if c:IsA("Tool") then task.defer(function() taApply(c) end) end end)
    char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then taClear() end end)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then taApply(tool) end
end

if LocalPlayer.Character then task.spawn(taHook, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(taHook)

function API:EnableToolAura()
    TA.enabled = true
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool then taApply(tool) end
end
function API:DisableToolAura() TA.enabled = false; taClear() end
function API:ToggleToolAura() if TA.enabled then self:DisableToolAura() else self:EnableToolAura() end end
function API:IsToolAuraEnabled() return TA.enabled end
function API:SetToolAuraColor(c) TA.color = c; taUpdateColor() end
function API:SetToolAuraRate(r)
    TA.rateMultiplier = r
    local char = LocalPlayer.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if tool and TA.enabled then taApply(tool) end
end

