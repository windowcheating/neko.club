-- 5) CURSOR PET (ONEKO)
-- ============================================================
local OP = {
    enabled = false, followTarget = true, color = accent(),
    size = 28, speed = 110, followDistance = 45, animSpeed = 0.13,
}
local ONEKO_PATH = "NLAssets/oneko.png"
local ONEKO_URL  = "https://files.catbox.moe/twwjix.png"

task.spawn(function()
    if not isfolder("NLAssets") then makefolder("NLAssets") end
    if not isfile(ONEKO_PATH) then
        local ok, body = pcall(function() return game:HttpGet(ONEKO_URL) end)
        if ok and body then writefile(ONEKO_PATH, body) end
    end
end)

if getgenv().__NL_OnekoGui then pcall(function() getgenv().__NL_OnekoGui:Destroy() end) end
local gui = Instance.new("ScreenGui")
gui.Name = "NL_OnekoCat"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
local pOk = pcall(function() gui.Parent = Services.CoreGui end)
if not pOk then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
getgenv().__NL_OnekoGui = gui

local img = Instance.new("ImageLabel")
img.Name = "Cat"
img.BackgroundTransparency = 1
img.Size = UDim2.fromOffset(OP.size, OP.size)
img.AnchorPoint = Vector2.new(0.5, 0.5)
img.ImageColor3 = OP.color
img.ImageRectSize = Vector2.new(32, 32)
img.Visible = false
img.Parent = gui

task.spawn(function()
    task.wait(0.2)
    if isfile(ONEKO_PATH) then
        local get = getcustomasset or getsynasset
        if get then img.Image = get(ONEKO_PATH) end
    end
end)

local FRAMES = {
    idle={{3,3}}, N={{1,2},{1,3}}, NE={{0,2},{0,3}}, E={{3,0},{3,1}},
    SE={{5,1},{5,2}}, S={{6,3},{7,2}}, SW={{5,3},{6,1}}, W={{4,2},{4,3}},
    NW={{1,0},{1,1}}, tired={{3,2}}, sleeping={{2,0},{2,1}}, scratchSelf={{5,0},{6,0},{7,0}},
}
local cam = workspace.CurrentCamera
local petPos = cam.ViewportSize / 2
local state, frame, timer = "idle", 1, 0
local special, specialFrame = nil, 1

local function setFrame(s, f)
    local frames = FRAMES[s]; if not frames then return end
    local p = frames[(f - 1) % #frames + 1]
    img.ImageRectOffset = Vector2.new(p[1] * 32, p[2] * 32)
end

local function setState(s)
    if state ~= s then state, frame, timer = s, 1, 0; setFrame(s, 1) end
end

local function dirFromVec(dx, dy)
    local a = math.deg(math.atan2(-dy, dx))
    if a >= -22.5 and a < 22.5 then return "E"
    elseif a >= 22.5 and a < 67.5 then return "NE"
    elseif a >= 67.5 and a < 112.5 then return "N"
    elseif a >= 112.5 and a < 157.5 then return "NW"
    elseif a >= 157.5 or a < -157.5 then return "W"
    elseif a >= -157.5 and a < -112.5 then return "SW"
    elseif a >= -112.5 and a < -67.5 then return "S"
    else return "SE" end
end

setFrame("idle", 1)

getgenv().__NL_OnekoConn = Services.RunService.RenderStepped:Connect(function(dt)
    if not OP.enabled then img.Visible = false; return end
    img.Visible = true
    img.ImageColor3 = OP.color
    img.Size = UDim2.fromOffset(OP.size, OP.size)

    local targetPos
    if OP.followTarget then
        local target = (getgenv().Config and getgenv().Config.ForceHit and getgenv().Config.ForceHit.Target)
            or (getgenv().KillAura and getgenv().KillAura.CurrentTarget)
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                local sp, on = cam:WorldToViewportPoint(head.Position)
                if on then targetPos = Vector2.new(sp.X, sp.Y) end
            end
        end
        targetPos = targetPos or Services.UserInputService:GetMouseLocation()
        local diff = targetPos - petPos
        local dist = diff.Magnitude
        if dist > OP.followDistance then
            special, specialFrame = nil, 1
            local dir = diff.Unit
            petPos = petPos + dir * math.min(OP.speed * dt, dist - OP.followDistance)
            setState(dirFromVec(diff.X, diff.Y))
            timer = timer + dt
            if timer >= OP.animSpeed then
                timer = 0; frame = frame + 1
                if frame > #FRAMES[state] then frame = 1 end
                setFrame(state, frame)
            end
        else
            setState("idle")
            specialFrame = specialFrame + dt
            if not special and specialFrame > 3 and math.random() < 0.01 then
                special = math.random(1, 2) == 1 and "sleeping" or "scratchSelf"
                specialFrame = 1; timer = 0
            end
            if special then
                timer = timer + dt
                if timer >= OP.animSpeed then
                    timer = 0; specialFrame = specialFrame + 1
                    if specialFrame > #FRAMES[special] * 6 then
                        special, specialFrame = nil, 1; setFrame("idle", 1)
                    else
                        setFrame(special, math.ceil(specialFrame / 6))
                    end
                end
            end
        end
    end

    local vp = cam.ViewportSize
    local half = OP.size / 2
    petPos = Vector2.new(math.clamp(petPos.X, half, vp.X - half), math.clamp(petPos.Y, half, vp.Y - half))
    img.Position = UDim2.fromOffset(petPos.X, petPos.Y)
end)

function API:EnableCursorPet()  OP.enabled = true end
function API:DisableCursorPet() OP.enabled = false; img.Visible = false end
