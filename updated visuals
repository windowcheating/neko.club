function API:SetCrosshairTextString(s)
    -- Backwards-compatible: if someone sets "neko.cafe" as a single string, split it.
    if s == "neko.cafe" or s == "larptic" then
        XH.textPrefix = "neko"; XH.textSuffix = ".cafe"
    else
        XH.textPrefix = s; XH.textSuffix = ""
    end
end
function API:SetCrosshairHideGame(v)
    XH.hideGameCrosshair = v
    if not v then setGameCrosshairVisible(true) end
end

