-- 7) CROSSHAIR
-- ============================================================
local XH = {
    enabled = false, position = "mouse", hideGameCrosshair = false,
    lines = 4, radius = 14, length = 9, thickness = 2, rotation = 0,
    color = accent(), outlineColor = Color3.fromRGB(0,0,0),
    spin = true, spinSpeed = 120, pulse = true, pulseSpeed = 4,
    gapPulse = 5, sizePulse = 6,
    text = true, textPrefix = "neko", textSuffix = ".cafe",
    textPos = "bottom right",
    textColor       = Color3.fromRGB(255, 255, 255),  -- prefix color
    textAccentColor = accent(),                       -- suffix color
}

local lines, outlines = {}, {}
local xhText       = Drawing.new("Text")  -- "neko"
local xhTextSuffix = Drawing.new("Text")  -- ".cafe"
for _, t in ipairs({ xhText, xhTextSuffix }) do
    t.Font = 2; t.Size = 13; t.Outline = true
    t.OutlineColor = Color3.fromRGB(0, 0, 0); t.ZIndex = 3
end
xhText.Color       = XH.textColor
xhTextSuffix.Color = XH.textAccentColor
local xhRot = 0

local function ensureCount(n)
    while #lines > n do
        local l = table.remove(lines); local o = table.remove(outlines)
        if l then l:Remove() end; if o then o:Remove() end
    end
    while #lines < n do
        local o = Drawing.new("Line"); o.ZIndex = 1; table.insert(outlines, o)
        local l = Drawing.new("Line"); l.ZIndex = 2; table.insert(lines, l)
    end
end

local function setGameCrosshairVisible(v)
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    local ms = pg and pg:FindFirstChild("Main Screen")
    if ms then
        local aim = ms:FindFirstChild("Aim")
        if aim and aim:IsA("GuiObject") then aim.Visible = v end
    end
end

local function xhPos()
    local m = Services.UserInputService:GetMouseLocation()
    if XH.position == "mouse" then return m end
    if XH.position == "gun tip" then
        local char = LocalPlayer.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        local h = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
        if h then
            local sp, on = cam:WorldToViewportPoint(h.Position)
            if on then return Vector2.new(sp.X, sp.Y) end
        end
        return m
    end
    if XH.position == "target" then
        local target = (getgenv().Config and getgenv().Config.ForceHit and getgenv().Config.ForceHit.Target)
            or (getgenv().KillAura and getgenv().KillAura.CurrentTarget)
        if target and target.Character then
            local part = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local sp, on = cam:WorldToViewportPoint(part.Position)
                if on then return Vector2.new(sp.X, sp.Y) end
            end
        end
        return m
    end
    return m
end

getgenv().__NL_CrosshairConn = Services.RunService.RenderStepped:Connect(function(dt)
    if not XH.enabled then
        for i = 1, #lines do lines[i].Visible = false; outlines[i].Visible = false end
        xhText.Visible = false
        xhTextSuffix.Visible = false
        return
    end
    if XH.hideGameCrosshair then setGameCrosshairVisible(false) end
    local center = xhPos()
    if XH.spin then xhRot = (xhRot + XH.spinSpeed * dt) % 360 end
    local pulse = XH.pulse and math.sin(tick() * XH.pulseSpeed) or 0
    local radius = math.max(1, XH.radius + pulse * XH.gapPulse)
    local outer = radius + math.max(2, XH.length + pulse * XH.sizePulse)
    ensureCount(XH.lines)
    local step = 2 * math.pi / XH.lines
    local rot = math.rad(xhRot + XH.rotation)
    for i = 1, XH.lines do
        local l = lines[i]; local o = outlines[i]
        local a = rot + (i - 1) * step
        local dx, dy = math.cos(a), math.sin(a)
        o.From = center + Vector2.new(dx * (radius - 0.5), dy * (radius - 0.5))
        o.To   = center + Vector2.new(dx * (outer + 0.5), dy * (outer + 0.5))
        o.Color = XH.outlineColor; o.Thickness = XH.thickness + 1.5; o.Visible = true
        l.From = center + Vector2.new(dx * radius, dy * radius)
        l.To   = center + Vector2.new(dx * outer, dy * outer)
        l.Color = XH.color; l.Thickness = XH.thickness; l.Visible = true
    end
    if XH.text and (XH.textPrefix ~= "" or XH.textSuffix ~= "") then
        xhText.Text        = XH.textPrefix
        xhTextSuffix.Text  = XH.textSuffix
        xhText.Color       = XH.textColor
        xhTextSuffix.Color = XH.textAccentColor

        local prefixW = xhText.TextBounds.X
        local suffixW = xhTextSuffix.TextBounds.X
        local totalW  = prefixW + suffixW

        local p
        if XH.textPos == "bottom right" then
            p = center + Vector2.new(outer + 14, outer + 12)
        else
            p = center + Vector2.new(-(outer + 14 + totalW), outer + 12)
        end

        xhText.Position       = p
        xhTextSuffix.Position = p + Vector2.new(prefixW, 0)
        xhText.Visible        = true
        xhTextSuffix.Visible  = true
    else
        xhText.Visible = false
        xhTextSuffix.Visible = false
    end
end)

