-- STATE
-- ============================================================
local S = {
    SilentAimEnabled   = true,
    SilentAimNotifier  = false,
    SilentAimWallCheck = false,
    ShootingMethod     = "New (blatant)",
    AutoGrabGun        = false,
    AdaptiveLead       = false,
    PingCompensation   = 1.0,
    BulletSpeed        = 2800,
    PredictionPing     = 50,
    AutoPrediction     = true,
    AutoPredBeta       = false,
    AutoPredBetaBuffer = 18,
    AutoPredBetaValue  = 50,
    Keybinds = {
        Shoot   = Enum.KeyCode.E,
        GrabGun = Enum.KeyCode.Y,
        Throw   = Enum.KeyCode.U,
    },
    SilentAimLastTarget = nil,
    SilentAimLastTargetTime = 0,
    SilentAimLastHealth = nil,
}

local roleCache = {}

local function fetchRoles()
    local ok, data = pcall(function()
        local remote = Services.ReplicatedStorage:FindFirstChild("GetPlayerData", true)
        if remote then return remote:InvokeServer() end
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do roleCache[k] = v end
    end
end

local function getMurderer()
    for _, pl in ipairs(Services.Players:GetPlayers()) do
        if pl ~= LocalPlayer then
            if (pl.Character and pl.Character:FindFirstChild("Knife"))
                or (pl.Backpack and pl.Backpack:FindFirstChild("Knife")) then
                return pl
            end
        end
    end
    for name, data in pairs(roleCache) do
        if type(data) == "table" and data.Role == "Murderer" then
            local pl = Services.Players:FindFirstChild(name)
            if pl then return pl end
        end
    end
    return nil
end

local function resolveTarget()
    local murderer = getMurderer()
    if murderer and murderer.Character and murderer.Character:FindFirstChild("HumanoidRootPart") then
        return murderer
    end
    local best, bestDist = nil, math.huge
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, pl in ipairs(Services.Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local root = pl.Character:FindFirstChild("HumanoidRootPart")
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < bestDist then bestDist, best = d, pl end
            end
        end
    end
    return best
end

local function getCombatData()
    local char = LocalPlayer.Character
    if not char then return nil end
    local myHRP = char:FindFirstChild("HumanoidRootPart")
    local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
    if not myHRP or not arm then return nil end

    local target = resolveTarget()
    if not target or not target.Character then return nil end
    local root = target.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local vel   = root.AssemblyLinearVelocity or Vector3.new(0,0,0)
    local dist  = (root.Position - myHRP.Position).Magnitude
    local ping  = getRealPing() / 1000
    local travel = dist / S.BulletSpeed
    local serverTick = 1/60

    local speedBonus = math.clamp(vel.Magnitude / 20, 0, 0.05)
    local jumpBonus  = 0
    if vel.Y > 2 then jumpBonus = 0.02 end

    local velLead = (vel.Magnitude / 100) * 0.05
    if S.AdaptiveLead then
        local pingFactor = (ping * 1000) / 50
        velLead = velLead * pingFactor * S.PingCompensation
    end

    local basePred = S.PredictionPing / 1000
    local totalLead = travel + ping + serverTick + speedBonus + jumpBonus + basePred + velLead
    local targetPos = root.Position + (vel * totalLead)

    local originPos
    if S.ShootingMethod == "New (blatant)" then
        originPos = root.Position + Vector3.new(0, 0.5, -0.6)
        targetPos = targetPos + (vel * 0.02)
    else
        originPos = arm.Position
        targetPos = targetPos + Vector3.new(0, dist/140, 0)
    end
    return root, originPos, targetPos, target
end

local function isWallBetween(originPos, targetPos, targetChar)
    local myChar = LocalPlayer.Character
    if not myChar then return false end
    local myHead = myChar:FindFirstChild("Head")
    if not myHead then return false end

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { myChar, targetChar, workspace.CurrentCamera }
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = true

    local result = workspace:Raycast(myHead.Position, targetPos - myHead.Position, params)
    if not result then return false end
    local hitPart = result.Instance
    if hitPart then
        if hitPart.CanCollide == false or hitPart.Transparency >= 0.95 then return false end
        local model = hitPart:FindFirstAncestorOfClass("Model")
        if model and (Services.Players:GetPlayerFromCharacter(model) or model == targetChar) then
            return false
        end
    end
    return true
end

-- ============================================================
-- HIT CHAMS ENGINE
-- ============================================================
local hitChamFolder = Instance.new("Folder")
hitChamFolder.Name = "Sheriff_HitChams"
hitChamFolder.Parent = workspace

local function createHitChams(character, color, duration)
    if not character then return end
    local mat = Enum.Material.Neon
    local trans = 0
    local effect = "fade"

    local model = Instance.new("Model")
    model.Name = "hit_cham"

    local function dress(part, srcPart)
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.Material = mat; part.Color = color; part.Transparency = trans
        for _, d in ipairs(part:GetDescendants()) do
            if d:IsA("JointInstance") or d:IsA("Constraint") or d:IsA("TouchTransmitter")
                or d:IsA("Script") or d:IsA("LocalScript") then
                d:Destroy()
            end
        end
        part.Parent = model
        part.CFrame = srcPart.CFrame
        part.Anchored = true
        local size = srcPart.Size
        task.spawn(function()
            local steps = 20
            local delay = duration / steps
            for i = 1, steps do
                task.wait(delay)
                if not (part and part.Parent) then return end
                part.Transparency = trans + (1 - trans) * (i / steps)
            end
            if part and part.Parent then part:Destroy() end
        end)
    end

    local whitelist = {
        "Head","Torso","UpperTorso","LowerTorso",
        "LeftArm","RightArm","LeftLeg","RightLeg",
        "LeftUpperArm","LeftLowerArm","LeftHand",
        "RightUpperArm","RightLowerArm","RightHand",
        "LeftUpperLeg","LeftLowerLeg","LeftFoot",
        "RightUpperLeg","RightLowerLeg","RightFoot",
    }
    local set = {}
    for _, n in ipairs(whitelist) do set[n] = true end

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") and set[obj.Name] then
            local clone = Instance.new("Part")
            clone.Size = obj.Size
            clone.Shape = Enum.PartType.Block
            dress(clone, obj)
        end
    end

    model.Parent = hitChamFolder
    task.delay(duration + 0.1, function() if model and model.Parent then model:Destroy() end end)
end

-- ============================================================
-- HIT SOUND (BOOSTED)
-- ============================================================
local HitSoundGroup = Instance.new("SoundGroup")
HitSoundGroup.Name = "Sheriff_HitSoundGroup"
HitSoundGroup.Volume = 10
HitSoundGroup.Parent = Services.SoundService

local HitSound = Instance.new("Sound")
HitSound.Name = "Sheriff_HitSound"
HitSound.Volume = 5
HitSound.RollOffMode = Enum.RollOffMode.Inverse
HitSound.RollOffMinDistance = 5
HitSound.RollOffMaxDistance = 500
HitSound.SoundGroup = HitSoundGroup
HitSound.Parent = Services.SoundService

local HitSoundMasterGain = 1.75
local HitSoundEnabled = true
local HitSoundId = "https://files.catbox.moe/bgy8au.ogg"

local function playHitSound()
    if not HitSoundEnabled then return end
    local id = tostring(HitSoundId or "")
    if id == "" then return end
    HitSound.Volume = 5 * (HitSoundMasterGain or 1)
    if id:find("^http") then
        task.spawn(function()
            local folder = "NLAssets"
            if not isfolder(folder) then makefolder(folder) end
            local ext = id:match("%.%w+$") or ".ogg"
            local fname = id:gsub("[^%w]", "")..ext
            local path = folder.."/"..fname
            if not isfile(path) then
                local ok, body = pcall(function() return game:HttpGet(id) end)
                if ok and body and not body:find("404") then writefile(path, body) end
            end
            if isfile(path) then
                local asset = getcustomasset(path)
                if asset then
                    HitSound.SoundId = asset
                    HitSound:Play()
                end
            end
        end)
    else
        HitSound.SoundId = "rbxassetid://"..id:gsub("rbxassetid://", "")
        HitSound:Play()
    end
end

