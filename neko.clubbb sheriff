-- HIT FX: CHAMS
-- ============================================================
local chamFolder = Instance.new("Folder", workspace)
chamFolder.Name = "Sheriff_HitChams"

local function createHitChams(character, color, duration)
    if not character then return end
    local model = Instance.new("Model")
    model.Name = "hit_cham"
    
    local function dress(part, srcPart)
        part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
        part.Massless = true; part.Material = Enum.Material.Neon; part.Color = color; part.Transparency = 0
        part.Parent = model
        part.CFrame = srcPart.CFrame
        part.Anchored = true
        
        task.spawn(function()
            task.wait(duration)
            if not (part and part.Parent) then return end
            Services.TweenService:Create(part, TweenInfo.new(0.5), {Transparency = 1}):Play()
            task.wait(0.5)
            if part and part.Parent then part:Destroy() end
        end)
    end

    local whitelist = {
        "Head","Torso","UpperTorso","LowerTorso","LeftArm","RightArm","LeftLeg","RightLeg",
        "LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand",
        "LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot",
    }
    local set = {}
    for _, n in ipairs(whitelist) do set[n] = true end

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("BasePart") and set[obj.Name] then
            local clone = Instance.new("Part")
            clone.Size = obj.Size
            clone.Shape = Enum.PartType.Block
            dress(clone, obj)
        end
    end
    model.Parent = chamFolder
    task.delay(duration + 0.6, function() if model and model.Parent then model:Destroy() end end)
end

