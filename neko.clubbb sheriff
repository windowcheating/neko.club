function API:SetAdaptiveLead(v) S.AdaptiveLead = v end
function API:SetPingCompensation(v) S.PingCompensation = v end
function API:SetBulletSpeed(v) S.BulletSpeed = v end
function API:SetPrediction(v) if not S.AutoPredBeta then S.PredictionPing = v end end
function API:GetPrediction() return S.PredictionPing end
function API:IsAutoPredictionOn() return S.AutoPrediction end
function API:IsAutoPredBetaOn() return S.AutoPredBeta end

function API:EnableAutoPrediction(v)
    S.AutoPrediction = v
    if v then
        S.AutoPredBeta = false; stopAutoPredBeta()
        autoPredConn = Services.RunService.Heartbeat:Connect(function()
            S.PredictionPing = getRealPing()
        end)
    else stopAutoPred() end
end
function API:EnableAutoPredBeta(v)
    S.AutoPredBeta = v
    if v then
        S.AutoPrediction = false; stopAutoPred()
        autoPredBetaConn = Services.RunService.RenderStepped:Connect(function()
            local pred = math.floor(calculatePrediction(getRealPing()) + 0.5)
            S.PredictionPing = pred
        end)
    else stopAutoPredBeta() end
end
function API:SetAutoPredBetaPrediction(v) if not S.AutoPredBeta then S.PredictionPing = v end end
function API:SetShootKey(k) if k then S.Keybinds.Shoot = k end end
function API:SetGrabGunKey(k) if k then S.Keybinds.GrabGun = k end end
function API:GetShootKey() return S.Keybinds.Shoot.Name end
function API:GetGrabGunKey() return S.Keybinds.GrabGun.Name end

