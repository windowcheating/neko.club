local hitSoundGroup = Instance.new("SoundGroup", Services.SoundService)
hitSoundGroup.Name = "Sheriff_HitSoundGroup"; hitSoundGroup.Volume = 10

local hitSound = Instance.new("Sound", Services.SoundService)
hitSound.Name = "Sheriff_HitSound"; hitSound.SoundGroup = hitSoundGroup
hitSound.RollOffMode = Enum.RollOffMode.Inverse; hitSound.RollOffMaxDistance = 500

local function playHitSound()
    if not S.HitSoundEnabled then return end
    local id = tostring(S.HitSoundId)
    if id == "" then return end

    hitSound.Volume = 5 * ((S.HitSoundVolume / 100) * 3.5)
    if id:find("^http") then
        task.spawn(function()
            local path = "NLAssets/" .. id:gsub("[^%w]", "") .. ".ogg"
            if not isfolder("NLAssets") then makefolder("NLAssets") end
            if not isfile(path) then
                local ok, body = pcall(function() return game:HttpGet(id) end)
                if ok and body and not body:find("404") then writefile(path, body) end
            end
            if isfile(path) then
                local asset = getcustomasset(path)
                if asset then hitSound.SoundId = asset; hitSound:Play() end
            end
        end)
    else
        hitSound.SoundId = "rbxassetid://" .. id:gsub("rbxassetid://", "")
        hitSound:Play()
    end
end

