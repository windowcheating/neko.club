local autoPredConn, autoPredBetaConn

local function calculatePrediction(ping)
    ping = math.clamp(tonumber(ping) or 50, 0, 400)
    if ping <= 35 then return ping
    elseif ping <= 50 then return ping + ((ping - 35) / 15) * 18
    else return ping + (S.AutoPredBetaBuffer or 18) end
end

local function stopAutoPred()
    if autoPredConn then autoPredConn:Disconnect(); autoPredConn = nil end
end
local function stopAutoPredBeta()
    if autoPredBetaConn then autoPredBetaConn:Disconnect(); autoPredBetaConn = nil end
end

Services.UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == S.Keybinds.Shoot then task.spawn(fireSilentAim)
    elseif input.KeyCode == S.Keybinds.GrabGun then task.spawn(grabGunAction) end
end)

task.spawn(function()
    while task.wait(0.1) do
        if S.AutoGrabGun then
            local drop = workspace:FindFirstChild("GunDrop", true)
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if drop and hrp then
                pcall(function() firetouchinterest(hrp, drop, 0); firetouchinterest(hrp, drop, 1) end)
            end
        end
    end
end)

task.spawn(function() while task.wait(1.5) do fetchRoles() end end)

