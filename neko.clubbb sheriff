-- ============================================================
local function fireSilentAim()
    if not S.SilentAimEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local gun = char:FindFirstChild("Gun") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
    if not gun then return end
    if gun.Parent ~= char then char.Humanoid:EquipTool(gun); task.wait(0.05) end

    local root, originPos, targetPos, targetPlayer = getCombatData()
    if not root or not originPos or not targetPos or not targetPlayer then return end
    if S.SilentAimWallCheck and isWallBetween(originPos, targetPos, root.Parent) then return end

    local remote = gun:FindFirstChild("Shoot") or Services.ReplicatedStorage:FindFirstChild("ShootGun")
    if remote then
        pcall(function() remote:FireServer(CFrame.lookAt(originPos, targetPos), CFrame.new(targetPos)) end)
        
        -- Visuals FX
        createTracer(originPos, targetPos)
        
        task.spawn(function()
            task.wait(0.08)
            local tc = targetPlayer.Character
            if not tc then return end
            local hum = tc:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            
            local isKnocked = false
            local be = tc:FindFirstChild("BodyEffects")
            if be and (be:FindFirstChild("K.O") or be:FindFirstChild("KO")) then
                if (be.K.O or be.KO).Value then isKnocked = true end
            end
            
            local prevHealth = S.SilentAimLastHealth
            local curHealth = hum.Health
            S.SilentAimLastHealth = curHealth
            
            if isKnocked or (prevHealth ~= nil and curHealth < prevHealth) or hum.Health <= 0 then
                local dmg = math.random(25, 85)
                if S.HitChamsEnabled then createHitChams(tc, S.HitChamsColor, S.HitChamsDuration) end
                if S.HitEffectEnabled then createHitEffect(tc) end
                if S.DamageIndicatorEnabled then showDamageIndicator(dmg, root.Position + Vector3.new(0,3,0)) end
                playHitSound()
            end
        end)
    end
end

local function grabGunAction()
    local d = workspace:FindFirstChild("GunDrop", true)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if d and hrp then
        local old = hrp.CFrame; hrp.CFrame = d.CFrame; task.wait(0.05); hrp.CFrame = old
    end
end

