-- HIT FX: TRACERS
-- ============================================================
local tracerFolder = Instance.new("Folder", workspace.CurrentCamera)
tracerFolder.Name = "Sheriff_Tracers"
local activeTracers = {}

local function createTracer(from, to)
    if not S.BulletTracers then return end
    
    local startPart = Instance.new("Part")
    startPart.Size = Vector3.new(0, 0, 0); startPart.Transparency = 1
    startPart.CanCollide = false; startPart.Anchored = true; startPart.Massless = true
    startPart.CFrame = CFrame.new(from); startPart.Parent = tracerFolder

    local endPart = Instance.new("Part")
    endPart.Size = Vector3.new(0, 0, 0); endPart.Transparency = 1
    endPart.CanCollide = false; endPart.CanQuery = false; endPart.Anchored = true; endPart.Massless = true
    endPart.CFrame = CFrame.new(to); endPart.Parent = tracerFolder

    local a0 = Instance.new("Attachment", startPart)
    local a1 = Instance.new("Attachment", endPart)
    local beam = Instance.new("Beam", startPart)
    beam.Attachment0 = a0; beam.Attachment1 = a1
    beam.FaceCamera = true; beam.LightEmission = 1; beam.LightInfluence = 0
    beam.Color = ColorSequence.new(S.TracerColor)
    beam.Width0 = S.TracerWidth; beam.Width1 = S.TracerWidth
    beam.Texture = "rbxassetid://446111271"
    beam.TextureMode = Enum.TextureMode.Wrap; beam.TextureLength = 3; beam.TextureSpeed = 3
    beam.Transparency = NumberSequence.new(0); beam.ZOffset = 0

    table.insert(activeTracers, {
        startPart = startPart, endPart = endPart, beam = beam,
        createdAt = tick(), lifetime = S.TracerLifetime,
    })
end

Services.RunService.Heartbeat:Connect(function()
    local now = tick()
    for i = #activeTracers, 1, -1 do
        local tr = activeTracers[i]
        local p = (now - tr.createdAt) / tr.lifetime
        if p >= 1 then
            if tr.startPart and tr.startPart.Parent then tr.startPart:Destroy() end
            if tr.endPart and tr.endPart.Parent then tr.endPart:Destroy() end
            table.remove(activeTracers, i)
        else
            if tr.beam and tr.beam.Parent then
                tr.beam.Transparency = NumberSequence.new(p)
                tr.beam.Color = ColorSequence.new(S.TracerColor)
                tr.beam.Width0 = S.TracerWidth; tr.beam.Width1 = S.TracerWidth
            end
        end
    end
end)

