local function showDamageIndicator(amount, worldPos)
    if not S.DamageIndicatorEnabled or not worldPos then return end
    
    -- Phantom Forces Style
    local attach = Instance.new("Attachment")
    attach.WorldPosition = worldPos; attach.Parent = workspace.Terrain

    local billboard = Instance.new("BillboardGui", fxGui)
    billboard.Size = UDim2.new(0, 150, 0, 60); billboard.AlwaysOnTop = true
    billboard.Adornee = attach

    local label = Instance.new("TextLabel", billboard)
    label.Text = tostring(math.floor(amount))
    label.TextColor3 = S.DamageIndicatorColor
    label.TextSize = 26; label.Font = Enum.Font.GothamBold
    label.Size = UDim2.new(1, 0, 1, 0); label.BackgroundTransparency = 1
    label.Position = UDim2.new(0.5, -1, 0.5, -10); label.AnchorPoint = Vector2.new(0.5, 0.5)

    local shadow = label:Clone()
    shadow.TextColor3 = Color3.fromRGB(67, 67, 67)
    shadow.Position = UDim2.new(0.5, 0, 0.5, -9)
    shadow.ZIndex = 1; label.ZIndex = 2; shadow.Parent = billboard
    
    local stroke = Instance.new("UIStroke", shadow)
    stroke.Thickness = 1.5; stroke.Color = Color3.new(0,0,0)

    local targetOffset = Vector3.new(math.random(-10,10), math.random(3,6), math.random(-10,10))
    
    task.spawn(function()
        local life = 1.35
        Services.TweenService:Create(billboard, TweenInfo.new(0.04), { Size = UDim2.new(0, 150, 0, 60) }):Play()
        local t = 0
        while t < life do
            t = t + task.wait()
            local p = t / life
            billboard.StudsOffset = Vector3.new(0,0,0):Lerp(targetOffset, math.sin(p * math.pi/2))
            if p > 0.5 then
                local fade = (p - 0.5) / 0.5
                label.TextTransparency = fade; shadow.TextTransparency = fade; stroke.Transparency = fade
            end
        end
        billboard:Destroy(); attach:Destroy()
    end)
end

local AURA_IDS = {
    starlight = "rbxassetid://134645216613107", heavenly = "rbxassetid://139300897520961",
    ribbon = "rbxassetid://132069507632161", sakura = "rbxassetid://81755778619404",
    angel = "rbxassetid://97658130917593", wind = "rbxassetid://80694081850877",
