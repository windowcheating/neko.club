local function createHitEffect(character)
    if not S.HitEffectEnabled then return end
    local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
    if not root then return end

    if S.HitEffectType == "Blood Splatter" then
        local bloodColor = S.HitEffectColor
        if bloodColor == Color3.new(1,1,1) then bloodColor = Color3.fromRGB(120, 10, 10) end
        
        for i = 1, 12 do
            task.spawn(function()
                local part = Instance.new("Part")
                part.Size = Vector3.new(0.12, 0.12, 0.12); part.Color = bloodColor
                part.Material = Enum.Material.Neon; part.Anchored = true; part.Parent = workspace
                local a0 = Instance.new("Attachment", part); a0.Position = Vector3.new(0, 0.12, 0)
                local a1 = Instance.new("Attachment", part); a1.Position = Vector3.new(0, -0.12, 0)
                local trail = Instance.new("Trail")
                trail.Attachment0 = a0; trail.Attachment1 = a1
                trail.Color = ColorSequence.new(bloodColor); trail.Lifetime = 0.25
                trail.FaceCamera = true; trail.Parent = part
                
                local vel = Vector3.new(math.random(-20,20), math.random(10,30), math.random(-20,20))
                local pos = root.Position
                part.CFrame = CFrame.new(pos)
                
                local elapsed = 0
                while elapsed < 1.8 do
                    elapsed = elapsed + 0.016; vel = vel + Vector3.new(0, -0.8, 0)
                    local nextPos = pos + vel * 0.016
                    local hit = workspace:Raycast(pos, nextPos - pos, RaycastParams.new())
                    if hit then break end
                    part.CFrame = CFrame.lookAt(pos, nextPos)
                    task.wait(); pos = nextPos
                end
                trail.Enabled = false; task.wait(0.3); part:Destroy()
            end)
        end
    else
        local id = AURA_IDS[S.HitEffectType]; if not id then return end
        local ok, template = pcall(function() return game:GetObjects(id)[1] end)
        if not ok or not template then return end
        
        local clone = template:Clone(); clone.Parent = workspace
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("PointLight") then d.Color = S.HitEffectColor
            elseif d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") then d.Color = ColorSequence.new(S.HitEffectColor) end
        end
        
        local particles = {}
        for _, child in ipairs(clone:GetChildren()) do
            local attach = character:FindFirstChild(child.Name) or root
            if child:IsA("BasePart") then
                child.CFrame = attach.CFrame; child.Anchored = true; child.Transparency = 1
                for _, d in ipairs(child:GetDescendants()) do
                    if d:IsA("ParticleEmitter") then d.LockedToPart = false; table.insert(particles, d) end
                end
            else
                local anchor = Instance.new("Part", clone)
                anchor.Size = Vector3.new(0.1,0.1,0.1); anchor.CFrame = attach.CFrame
                anchor.Transparency = 1; anchor.Anchored = true
                child.Parent = anchor
                for _, d in ipairs(child:GetDescendants()) do
                    if d:IsA("ParticleEmitter") then d.LockedToPart = false; table.insert(particles, d) end
                end
            end
        end
        for _, p in ipairs(particles) do pcall(function() p:Emit(25) end) end
        task.delay(S.HitEffectDuration + 1, function() if clone then clone:Destroy() end end)
    end
end

