local function getAccent()
    local theme = Library and Library.Theme
    if not theme or not theme.Accent then return Color3.fromHex("#9791df") end
    if typeof(theme.Accent) == "ColorSequence" then
        return theme.Accent.Keypoints[1].Value
    elseif typeof(theme.Accent) == "Color3" then
        return theme.Accent
    end
    return Color3.fromHex("#9791df")
end

